{
  "name": "heyta",
  "version": "0.0.0",
  "private": true,
  "description": "功能等价于滴答清单的任务 / 习惯 / 专注管理应用 —— 本地优先，全平台",
  "comment:license": "heyta 采用 MIT（见 docs/adr/0001-license-decision.md）。第三方代码归属见 THIRD_PARTY_LICENSES.md。注意：我们是 MIT 不代表可以用 AGPL 依赖 —— 分发物一旦含 AGPL 代码，义务会附着于整体。",
  "packageManager": "pnpm@11.8.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r build && pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "clean": "pnpm -r exec rm -rf dist node_modules",
    "verify:sync": "node scripts/verify-sync-loop.mjs",
    "verify:sync:dry": "node scripts/verify-sync-loop.mjs --dry-run",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:layering": "node scripts/check-layering.mjs",
    "check:ui-language": "node scripts/check-ui-language.mjs",
    "check:licenses": "node research/tools/license-inventory.mjs",
    "check:docs": "node research/tools/docs-link-check.mjs",
    "check:pricing": "node scripts/check-pricing-consistency.mjs",
    "check:ai-quota": "node scripts/check-ai-quota-consistency.mjs",
    "check:payment-entry": "node scripts/check-payment-entry.mjs",
    "check": "pnpm build && pnpm typecheck && pnpm check:migrations && pnpm check:layering && pnpm check:ui-language && pnpm check:licenses && pnpm check:docs && pnpm check:pricing && pnpm check:ai-quota && pnpm check:payment-entry && pnpm check:design && pnpm check:tokens && pnpm check:arkts && pnpm check:native-deps && pnpm check:mobile-bundle && pnpm check:materialized-reads && pnpm check:ai-coverage && pnpm check:ai-e2e",
    "check:materialized-reads": "node scripts/check-materialized-reads.mjs",
    "check:design": "node design-system/heyta/check-hardcoded.mjs",
    "verify:p1": "node scripts/verify-p1-sync.mjs",
    "verify:p2": "node scripts/verify-p2-node-host.mjs",
    "verify:mobile-conflict": "bash scripts/verify-mobile-conflict.sh",
    "verify:mobile-autosync": "bash scripts/verify-mobile-autosync.sh",
    "verify:mobile-edit": "bash scripts/verify-mobile-task-edit.sh",
    "verify:mobile-focus": "bash scripts/verify-mobile-focus.sh",
    "verify:mobile-calendar": "bash scripts/verify-mobile-calendar.sh",
    "verify:mobile-repeat": "bash scripts/verify-mobile-repeat.sh",
    "verify:mobile-ios": "bash scripts/verify-mobile-ios.sh",
    "verify:mobile-lists": "bash scripts/verify-mobile-lists.sh",
    "verify:mobile-tags": "bash scripts/verify-mobile-tags.sh",
    "verify:multi-end": "bash scripts/verify-multi-end-sync.sh",
    "verify:sync-recovery": "bash scripts/verify-sync-rejection-recovery.sh",
    "verify:harmony-toolchain": "bash scripts/verify-harmony-toolchain.sh",
    "verify:harmony-rnoh": "bash scripts/verify-harmony-rnoh.sh",
    "verify:web-sqlite": "node scripts/verify-web-sqlite.mjs",
    "verify:harmony-rnoh-js": "bash scripts/verify-harmony-rnoh-js.sh",
    "verify:i18n-failures": "node scripts/verify-i18n-failures.mjs",
    "check:tokens": "pnpm --filter @heyta/design-system run generate:check",
    "check:ai-coverage": "node scripts/check-ai-coverage.mjs",
    "check:ai-e2e": "node scripts/check-ai-e2e-preflight.mjs && pnpm --dir e2e run test",
    "check:arkts": "node design-system/heyta/check-arkts-compile.mjs",
    "check:native-deps": "node scripts/check-native-deps.mjs",
    "verify:ios-lan-http": "bash scripts/verify-ios-lan-http.sh",
    "verify:ai-live": "node scripts/verify-ai-live.mjs",
    "verify:ai-breakdown-live": "node scripts/verify-ai-breakdown-live.mjs",
    "verify:mcp-real": "node scripts/verify-mcp-real-client.mjs",
    "verify:ai-preferences-live": "node scripts/verify-ai-preferences-live.mjs",
    "build:android": "pnpm --filter @heyta/mobile run build:android",
    "build:android:debug": "pnpm --filter @heyta/mobile run build:android:debug",
    "build:ios": "pnpm --filter @heyta/mobile run build:ios",
    "check:mobile-bundle": "node scripts/check-mobile-bundle.mjs"
  },
  "devDependencies": {
    "@heyta/shared-schema": "workspace:*",
    "@heyta/sync-core": "workspace:*",
    "@types/node": "^20.0.0"
  },
  "license": "MIT"
}
