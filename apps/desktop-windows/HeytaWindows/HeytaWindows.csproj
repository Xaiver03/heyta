<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Windows 原生壳本体（WinUI 3 / Windows App SDK）。**只在 Windows 上构建** ——
    所以这里刻意做得很薄：能被 CI 验的那部分全在 `Heyta.Windows.Core` 里。

    职责只有三件：
      1. 窗口与 XAML 界面；
      2. 生命周期（初始化 AppApi、把 bundle 路径指到 exe 旁边）；
      3. 把界面事件转成 AppApi 调用。
    **任何业务规则都不许写在这里**（排序、完成态、派生视图都在 TS）。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Heyta.Shell</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>
    <UseWinUI>true</UseWinUI>
    <!-- 开发期跑 non-packaged（不需要 MSIX 就能启动）。widgets 那条路才需要 packaged。 -->
    <EnableMsixTooling>false</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <!--
      🔴 unpackaged 的 WinUI 3 **默认要求机器上装了 Windows App SDK 运行时**。
      带上这一条，运行时随产物一起走 ⇒ 换一台没装过运行时的机器也能直接起来。
      代价是产物变大；但对一个"要能给别人试"的原生应用来说这个代价值得：
      否则第一步就卡在"请先安装 Windows App Runtime"，
      而那是最容易被误判成"应用本身有问题"的失败形态。
    -->
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.5.1" />
    <ProjectReference Include="../Heyta.Windows.Core/Heyta.Windows.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- bundle 只有一份，且**不属于任何一个壳**：
         packages/app-host/bridge-bundle/native-bridge.js（由 packages/app-host/scripts/build-native-bridge.mjs 生成）。
         Windows 壳与 macOS 壳加载的是同一个文件；这里把它拷到 exe 旁边。 -->
    <None Include="../../../packages/app-host/bridge-bundle/native-bridge.js" Link="native-bridge.js" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    🔴 缺 bundle 就**明确报错**，而不是等运行时白屏。
    "窗口打开了但什么都没有"是最难排查的一类失败，而这里完全可以在构建期拦下。
  -->
  <Target Name="RequireBridgeBundle" BeforeTargets="Build">
    <Error Condition="!Exists('$(MSBuildProjectDirectory)/../../../packages/app-host/bridge-bundle/native-bridge.js')"
           Text="缺少 bridge-bundle/native-bridge.js。先在仓库根跑：node packages/app-host/scripts/build-native-bridge.mjs" />
  </Target>

</Project>
