<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Heyta.Shell.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:Heyta.Shell"
    Title="heyta">

    <Grid Padding="24" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Spacing="2">
            <TextBlock Text="heyta" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Windows 原生壳 · 界面是 WinUI 3，逻辑与存储是与 web / mobile 同一份 TS"
                       Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <TextBox x:Name="NewTaskTitle" Width="360" PlaceholderText="写点什么，回车添加" />
            <Button x:Name="AddButton" Content="添加" Style="{StaticResource AccentButtonStyle}" />
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="StatusText" Opacity="0.75" TextWrapping="Wrap" />

        <ListView Grid.Row="3" x:Name="TaskList" SelectionMode="None">
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="local:TaskItem">
                    <Grid ColumnSpacing="10" Padding="0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <!--
                          `Mode=OneTime` 是对的，不是省事：`TaskItem` 是**不可变**的
                          （Id/Title/Done 都只有 init），每次操作后我们是**重建整个列表**
                          再赋给 ItemsSource —— 没有"同一个对象的值变了要通知界面"这回事。
                          用 OneWay 反而会招来 XamlCompiler 的 WMC1506 警告：
                          "OneWay 绑定要求至少一个环节支持变更通知"。
                        -->
                        <CheckBox Grid.Column="0" IsChecked="{x:Bind Done, Mode=OneTime}"
                                  Click="OnToggleDone" Tag="{x:Bind Id}" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" VerticalAlignment="Center"
                                   TextWrapping="Wrap" />
                        <Button Grid.Column="2" Content="删除" Click="OnDelete" Tag="{x:Bind Id}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <TextBlock Grid.Row="4" x:Name="FooterText" Opacity="0.6" FontSize="12" TextWrapping="Wrap" />
    </Grid>
</Window>
