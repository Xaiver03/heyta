{
  "name": "@heyta/web",
  "version": "0.0.0",
  "private": true,
  "description": "heyta Web 客户端（本地优先，React 19 + Vite）",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
