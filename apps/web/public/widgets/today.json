{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${placeholderText}",
      "wrap": true,
      "isSubtle": true,
      "isVisible": "${showPlaceholder}"
    },
    {
      "type": "Container",
      "$when": "${!showPlaceholder}",
      "isVisible": "${!showPlaceholder}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${titleText}",
                  "wrap": true,
                  "weight": "Bolder",
                  "size": "Medium",
                  "maxLines": 1
                }
              ]
            },
            {
              "type": "Column",
              "width": "auto",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${countText}",
                  "wrap": true,
                  "isSubtle": true,
                  "size": "Small"
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${emptyText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${isEmpty}"
        },
        {
          "type": "Container",
          "$data": "${previewRows}",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "selectAction": {
                "type": "Action.Execute",
                "verb": "toggle",
                "title": "${actionText}",
                "data": {
                  "taskId": "${id}",
                  "targetIsDone": "${targetIsDone}"
                }
              },
              "columns": [
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${statusText}",
                      "wrap": true,
                      "size": "Small",
                      "color": "${style}",
                      "isSubtle": "${done}"
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${title}",
                      "wrap": true,
                      "maxLines": 2,
                      "color": "${style}",
                      "isSubtle": "${done}"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${overflowText}",
          "wrap": true,
          "size": "Small",
          "isSubtle": true,
          "spacing": "Small",
          "isVisible": "${overflowText != ''}"
        }
      ]
    }
  ]
}
