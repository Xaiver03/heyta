{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${placeholderText}",
      "wrap": true,
      "isSubtle": true,
      "isVisible": "${showPlaceholder}"
    },
    {
      "type": "Container",
      "isVisible": "${!showPlaceholder}",
      "items": [
        {
          "type": "TextBlock",
          "text": "${staleText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'stale'}"
        },
        {
          "type": "TextBlock",
          "text": "${idleText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'idle'}"
        },
        {
          "type": "TextBlock",
          "text": "${sessionTitle}",
          "wrap": true,
          "weight": "Bolder",
          "isVisible": "${state == 'active'}"
        },
        {
          "type": "TextBlock",
          "text": "${targetLabel}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'active'}"
        }
      ]
    }
  ]
}
