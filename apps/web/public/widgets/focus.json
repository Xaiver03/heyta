{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${placeholderText}",
      "wrap": true,
      "isSubtle": true,
      "isVisible": "${showPlaceholder}"
    },
    {
      "type": "Container",
      "$when": "${!showPlaceholder}",
      "isVisible": "${!showPlaceholder}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${titleText}",
                  "wrap": true,
                  "weight": "Bolder",
                  "size": "Medium",
                  "maxLines": 1
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${staleText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'stale'}"
        },
        {
          "type": "TextBlock",
          "text": "${idleText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'idle'}"
        },
        {
          "type": "TextBlock",
          "text": "${sessionTitle}",
          "wrap": true,
          "weight": "Bolder",
          "size": "Large",
          "maxLines": 2,
          "isVisible": "${state == 'active'}"
        },
        {
          "type": "TextBlock",
          "text": "${targetLabel}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${state == 'active'}"
        }
      ]
    }
  ]
}
