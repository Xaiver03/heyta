{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.5",
  "body": [
    {
      "type": "TextBlock",
      "text": "${placeholderText}",
      "wrap": true,
      "isSubtle": true,
      "isVisible": "${showPlaceholder}"
    },
    {
      "type": "Container",
      "$when": "${!showPlaceholder}",
      "isVisible": "${!showPlaceholder}",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "None",
          "columns": [
            {
              "type": "Column",
              "width": "stretch",
              "items": [
                {
                  "type": "TextBlock",
                  "text": "${titleText}",
                  "wrap": true,
                  "weight": "Bolder",
                  "size": "Medium",
                  "maxLines": 1
                }
              ]
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${emptyText}",
          "wrap": true,
          "isSubtle": true,
          "isVisible": "${isEmpty}"
        },
        {
          "type": "Container",
          "$data": "${previewRows}",
          "items": [
            {
              "type": "ColumnSet",
              "spacing": "Small",
              "columns": [
                {
                  "type": "Column",
                  "width": "stretch",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${title}",
                      "wrap": true,
                      "maxLines": 2
                    }
                  ]
                },
                {
                  "type": "Column",
                  "width": "auto",
                  "items": [
                    {
                      "type": "TextBlock",
                      "text": "${doneLabel}",
                      "wrap": true,
                      "color": "good",
                      "size": "Small",
                      "maxLines": 2
                    }
                  ]
                }
              ]
            },
            {
              "type": "TextBlock",
              "text": "${streakLabel}",
              "wrap": true,
              "isSubtle": true,
              "size": "Small",
              "spacing": "None"
            }
          ]
        },
        {
          "type": "TextBlock",
          "text": "${overflowText}",
          "wrap": true,
          "size": "Small",
          "isSubtle": true,
          "spacing": "Small",
          "isVisible": "${overflowText != ''}"
        }
      ]
    }
  ]
}
