<?xml version="1.0" encoding="utf-8"?>
<!--
  四象限组件的布局（W1-5）。

  ## 🔴 四个布局里的 `widget_row_*` / `widget_header` / `widget_message` **故意同名**

  `RemoteViews` 是按 id 在**它自己那份布局**里查找的，所以不同布局用同名 id 完全合法。
  换来的是 [WidgetViewParts] 里"行怎么画 / 头部怎么画 / 消息怎么画"**只有一份实现** ——
  而那里面有若干不报错的坑（可见性、`PendingIntent` 的 data URI、完成/未完成的文案）。
  这个布局的 id 声明处是 [WidgetViewParts]，别处改了名字这里不会编译失败、只会**画不出来**。

  ## 为什么颜色使用应用资源

  组件由**启动器**进程通过 `RemoteViews` 充气，不能依赖启动器自己的
  `?android:attr/...` 主题属性：不同启动器可能把它们固定解析成浅色组件主题。
  所以这里使用与 design-system 语义 token 对齐的 `@color/heyta_widget_*`，
  并由 `values-night/colors.xml` 在系统夜间模式下切换暗色档。

  ⚠️ 资源限定符在 `RemoteViews` 里的解析仍依赖启动器实现，所以这一条
  **必须在真机上验收**（亮暗两档都要看）。

  ## 固定槽而不是动态添加

  `RemoteViews` **不能动态添加子视图**（`addView` 在多数启动器上不可靠），所以行槽是预置的。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="10dp"
    android:background="@color/heyta_widget_surface">

    <TextView
        android:id="@+id/widget_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:ellipsize="end"
        android:textColor="@color/heyta_widget_foreground"
        android:textSize="13sp"
        android:textStyle="bold" />


    <!-- 象限 1：标题永远显示（连 0 也显示）—— 四象限的价值就是那个 2×2 的格局。 -->
    <TextView
        android:id="@+id/widget_quadrant_1_header"
        style="@style/HeytaWidgetGroupHeader" />


    <TextView
        android:id="@+id/widget_quadrant_1_row_0"
        style="@style/HeytaWidgetRow" />


    <TextView
        android:id="@+id/widget_quadrant_1_row_1"
        style="@style/HeytaWidgetRow" />


    <!-- 象限 2：标题永远显示（连 0 也显示）—— 四象限的价值就是那个 2×2 的格局。 -->
    <TextView
        android:id="@+id/widget_quadrant_2_header"
        style="@style/HeytaWidgetGroupHeader" />


    <TextView
        android:id="@+id/widget_quadrant_2_row_0"
        style="@style/HeytaWidgetRow" />


    <TextView
        android:id="@+id/widget_quadrant_2_row_1"
        style="@style/HeytaWidgetRow" />


    <!-- 象限 3：标题永远显示（连 0 也显示）—— 四象限的价值就是那个 2×2 的格局。 -->
    <TextView
        android:id="@+id/widget_quadrant_3_header"
        style="@style/HeytaWidgetGroupHeader" />


    <TextView
        android:id="@+id/widget_quadrant_3_row_0"
        style="@style/HeytaWidgetRow" />


    <TextView
        android:id="@+id/widget_quadrant_3_row_1"
        style="@style/HeytaWidgetRow" />


    <!-- 象限 4：标题永远显示（连 0 也显示）—— 四象限的价值就是那个 2×2 的格局。 -->
    <TextView
        android:id="@+id/widget_quadrant_4_header"
        style="@style/HeytaWidgetGroupHeader" />


    <TextView
        android:id="@+id/widget_quadrant_4_row_0"
        style="@style/HeytaWidgetRow" />


    <TextView
        android:id="@+id/widget_quadrant_4_row_1"
        style="@style/HeytaWidgetRow" />


    <TextView
        android:id="@+id/widget_message"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="@color/heyta_widget_foreground_muted"
        android:textSize="12sp" />

</LinearLayout>
