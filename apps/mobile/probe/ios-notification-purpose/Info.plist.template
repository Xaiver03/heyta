<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>HeytaNotifyPurposeProbe</string>
	<key>CFBundleIdentifier</key>
	<string>cloud.finlaw.heyta.notifypurposeprobe</string>
	<key>CFBundleName</key>
	<string>heyta 通知探针</string>
	<key>CFBundleDisplayName</key>
	<string>heyta 通知探针</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<!-- 🔴 CFBundleVersion 不能少：缺它时 `simctl launch` 只报
	     "did not return a process handle nor launch error"，看起来像装置坏了，
	     其实是系统拒绝起进程。 -->
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIDeviceFamily</key>
	<array><integer>1</integer><integer>2</integer></array>
	<key>UISupportedInterfaceOrientations</key>
	<array><string>UIInterfaceOrientationPortrait</string></array>
	<!-- scene 生命周期：声明了它，UIKit 才会向 AppDelegate 要 scene 配置。
	     为什么必须有它，见 main.swift 里 SceneDelegate 上面那段。 -->
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
	</dict>
	<!-- 🔴 这一枚就是被取证的对象。值由构建脚本注入唯一暗号，
	     人不看截图就没法从别处推出它，也就没法假绿。 -->
	<key>NSUserNotificationsUsageDescription</key>
	<string>__PURPOSE_MARKER__</string>
</dict>
</plist>
