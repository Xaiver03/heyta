kage="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[94,478][985,940]" drawing-order="1" hint="" /><node index="1" text="This text is still under legal review and is not in effect yet. We will announce the released version in the app." resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,940][985,1036]" drawing-order="2" hint="" /><node index="2" text="Version 1.8 - updated 2026-10-07" resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1057][581,1105]" drawing-order="3" hint="" /><node index="3" text="" resource-id="" class="android.view.ViewGroup" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1137][986,2164]" drawing-order="4" hint=""><node index="0" text="What this policy covers, and what it does not" resource-id="" class="android.view.View" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1179][986,1301]" drawing-order="1" hint="" /><node index="1" text="heyta is three different things at once: open-source software, a server you can run yourself, and the hosted service we operate. Responsibility differs completely across the three, and this policy binds only the third. That distinction is not wordplay: the statement you accept at sign-up reads “I agree to the terms of service and privacy policy of the server I am connecting to”, and “that server” may be a machine anyone has put in place." resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1322][986,1952]" drawing-order="2" hint="" /><node index="2" text="" resource-id="" class="android.view.ViewGroup" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[95,1973][986,2164]" drawing-order="3" hint="" /><node index="3" text="What you get" resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,2005][955,2053]" drawing-order="4" hint="" /><node index="4" text="The heyta app itself (client code for every platform and the server source code, MIT-licensed, free of charge)" resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[127,2063][955,2164]" drawing-order="5" hint="" /><node index="5" text="Who processes your data" resource-id="" class="android.widget.TextView" package="com.heyta" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickabl