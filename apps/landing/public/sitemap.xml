<?xml version="1.0" encoding="UTF-8"?>
<!--
  两个语言入口。hreflang 三件套（zh-CN / en / x-default）必须与
  index.html 里的 <link rel="alternate"> 以及 <link rel="canonical"> 说同一件事 ——
  三处任一不一致，搜索引擎就会各自挑一个当成"真正的那个页面"。

  刻意**只列** `/` 与 `/en/`：落地页是单页站点，其余路径都是 SPA 兜底，
  不指向自己的锚点（`#pricing` 之类），因为锚点不是独立 URL。
  `/app/` 不进 sitemap：它需要登录，见 robots.txt 的 Disallow。
-->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9"
        xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>https://heyta.finlaw.cloud/</loc>
    <changefreq>weekly</changefreq>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://heyta.finlaw.cloud/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://heyta.finlaw.cloud/en/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://heyta.finlaw.cloud/" />
  </url>
  <url>
    <loc>https://heyta.finlaw.cloud/en/</loc>
    <changefreq>weekly</changefreq>
    <xhtml:link rel="alternate" hreflang="zh-CN" href="https://heyta.finlaw.cloud/" />
    <xhtml:link rel="alternate" hreflang="en" href="https://heyta.finlaw.cloud/en/" />
    <xhtml:link rel="alternate" hreflang="x-default" href="https://heyta.finlaw.cloud/" />
  </url>
</urlset>
