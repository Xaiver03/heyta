{
  "name": "@heyta/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "heyta 桌面宿主（Electron）。壳只做三件事：开窗口、解析库文件位置、把渲染进程的请求挡在门内 —— 业务能力全部经 @heyta/node-host",
  "license": "MIT",
  "type": "module",
  "main": "dist/main.cjs",
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "electron dist/main.cjs"
  },
  "dependencies": {
    "@heyta/node-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "electron": "^44.4.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
