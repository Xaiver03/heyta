{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "rootDir": ".",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "types": ["node"],
    "moduleResolution": "bundler",
    "module": "ESNext"
  },
  "include": ["renderer/**/*", "vite.config.ts"],
  "exclude": ["node_modules", "dist", "renderer-dist"]
}
