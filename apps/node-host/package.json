{
  "name": "@heyta/node-host",
  "version": "0.0.0",
  "private": true,
  "description": "heyta 非 Web 宿主：真 SQLite 文件 + op-log 引擎 + 宿主无关同步客户端。接线与动作都在 @heyta/app-host，本包只剩\"用哪个驱动\"这一个平台差异",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "host": "node dist/cli.js",
    "mcp": "node dist/cli-mcp.js",
    "ai": "node dist/cli-ai.js",
    "local-api": "node dist/cli-local-api.js"
  },
  "dependencies": {
    "@heyta/ai": "workspace:*",
    "@heyta/app-host": "workspace:*",
    "@heyta/domain": "workspace:*",
    "@heyta/local-api": "workspace:*",
    "@heyta/op-log": "workspace:*",
    "@heyta/shared-schema": "workspace:*",
    "@heyta/storage": "workspace:*",
    "@heyta/sync-client": "workspace:*",
    "@heyta/sync-core": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
