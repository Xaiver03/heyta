签发与验签用的是同一个函数，两边错得对称，所以 48 条用例全绿 —— 直到把真实请求
打到真中心上，每一条都被判签名无效才暴露。

同时把默认 payment_type 从 'huifu' 改成 'huifu_wxpay'：中心实例只声明
huifu_wxpay/huifu_alipay/huifu_h5/huifu_app，基础类型 huifu 不可路由（503）。

补一条固定向量用例：期望值按中心契约独立算出，不是用本仓函数现算。
---
 server/src/billing/paycenter.adapter.ts       | 18 ++++++++----
 .../tests/billing-paycenter-adapter.spec.ts   | 29 ++++++++++++++++++-
 2 files changed, 41 insertions(+), 6 deletions(-)

diff --git a/server/src/billing/paycenter.adapter.ts b/server/src/billing/paycenter.adapter.ts
index f9b92d8e7..695e618fe 100644
--- a/server/src/billing/paycenter.adapter.ts
+++ b/server/src/billing/paycenter.adapter.ts
@@ -23,7 +23,7 @@
  * 这是接入中心在**代码量**上的直接收益。
  */
 
-import { createHmac, timingSafeEqual } from 'node:crypto';
+import { createHash, createHmac, timingSafeEqual } from 'node:crypto';
 import type { Currency } from './money';
 import { DEFAULT_PRICE_BOOK, grantsForSku, projectPrices } from './price-book';
 import type {
@@ -197,9 +197,14 @@ export const canonicalSignature = (
   timestamp: string,
   idempotencyKey: string,
 ): string => {
-  const bodyHash = createHmac('sha256', secret).update(body).digest('hex');
-  // 中心的契约是 sha256(body) 再进规范化串；这里同样先算 sha256 再 HMAC。
-  // ⚠️ 与中心 `platformauth` 的口径必须逐字节一致，否则每条回调都 401。
+  // 中心的契约是 `hex(sha256(body))`，**不是** HMAC(secret, body)。
+  //
+  // 这里曾经写成 createHmac('sha256', secret).update(body)，注释还写着"与中心逐字节一致"——
+  // 那条注释是错的，而因为签发与验签用了同一个函数，两边错得对称，所以单测一路是绿的。
+  // 代价是：对中心的每一次请求都会被判"签名无效"（中心那边的口径是对的）。
+  // 抓到它的是把真实请求打到真中心上，不是读代码。
+  const bodyHash = createHash('sha256').update(body).digest('hex');
+  // ⚠️ 与中心 `platformauth` 的口径必须逐字节一致，否则每条请求与回调都 401。
   const canonical = [
     method.trim().toUpperCase(),
     path.trim(),
@@ -348,7 +353,10 @@ export const createPaycenterBillingAdapter = (
           amount: (input.amountMinor / 100).toFixed(2),
           currency: input.currency,
           subject: input.description ?? input.priceId,
-          payment_type: config.paymentType ?? 'huifu',
+          // 默认必须是**渠道命名空间**的类型（huifu_wxpay），不能是基础类型 huifu。
+          // 中心的实例只声明 huifu_wxpay / huifu_alipay / huifu_h5 / huifu_app，
+          // 基础类型 huifu 不在其中：传 huifu 会得到 503 "no enabled instance"。
+          payment_type: config.paymentType ?? 'huifu_wxpay',
           return_url: input.successUrl,
         },
         `heyta:${outTradeNo}`,
diff --git a/server/tests/billing-paycenter-adapter.spec.ts b/server/tests/billing-paycenter-adapter.spec.ts
index 33d9b4d45..4d6434f61 100644
--- a/server/tests/billing-paycenter-adapter.spec.ts
+++ b/server/tests/billing-paycenter-adapter.spec.ts
@@ -60,6 +60,30 @@ const signedHeaders = (raw: string, over: Record<string, string> = {}) => {
   };
 };
 
+/**
+ * 固定向量：这条用例的期望值是按**中心的契约**（`hex(sha256(body))` 进规范化串）
+ * 独立算出来的，不是用本仓的 canonicalSignature 现算的。
+ *
+ * 为什么必须有它：原来的用例全部拿 canonicalSignature 生成期望签名，签发与验签
+ * 用的是同一个函数，所以算法错了也是绿的 —— 那条错（把 body 摘要写成 HMAC(secret, body)）
+ * 就这样活到联调，表现是"对中心的每一次请求都被判签名无效"。
+ */
+describe('canonicalSignature 与中心契约逐字节一致（固定向量）', () => {
+  it('body 摘要必须是 sha256(body)，不是 HMAC(secret, body)', () => {
+    const secret = 'e2e-fixed-vector-secret';
+    const body = Buffer.from('{"a":1}', 'utf8');
+    const got = canonicalSignature(secret, 'POST', '/api/v1/internal/payments/orders', body, '1700000000', 'fixed-1');
+    // 中心侧 platformauth.Sign 对同一组输入的结果：
+    expect(got).toBe('b572d1f63c8d7b8467af364e7134cb6c533ee3516f244536d72fe732a46bd059');
+  });
+
+  it('换一个 body 就换一个签名（防止退化成常数）', () => {
+    const a = canonicalSignature('s', 'POST', '/p', Buffer.from('{"a":1}'), '1700000000', 'i');
+    const b = canonicalSignature('s', 'POST', '/p', Buffer.from('{"a":2}'), '1700000000', 'i');
+    expect(a).not.toBe(b);
+  });
+});
+
 describe('amountYuanToMinor', () => {
   it('两位小数才认', () => {
     expect(amountYuanToMinor('30.00')).toBe(3000);
@@ -218,7 +242,10 @@ describe('createCheckout', () => {
     expect(await a.createCheckout(base)).toEqual({ qrCode: 'weixin://pay/1' });
     expect(sent.external_order_id).toBe('SS-ORDER-1');
     expect(sent.amount).toBe('30.00');
-    expect(sent.payment_type).toBe('huifu');
+    // 默认值必须是**渠道命名空间**的类型。改成 'huifu' 会得到中心 503
+    // "no enabled instance for payment type huifu"：中心的实例只声明
+    // huifu_wxpay / huifu_alipay / huifu_h5 / huifu_app，基础类型不可路由。
+    expect(sent.payment_type).toBe('huifu_wxpay');
   });
 
   it('跳转通道 → redirectUrl', async () => {
