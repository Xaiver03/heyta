# Super Sync Server - Production Environment Configuration
# Copy this file to .env and configure all required values

# =============================================================================
# REQUIRED SETTINGS
# =============================================================================

# Your domain (without https://)
# Caddy will automatically obtain SSL certificates for this domain
DOMAIN=sync.your-domain.com

# JWT secret for authentication tokens (minimum 32 characters). REQUIRED.
# Left empty on purpose: a shipped placeholder is a publicly known signing key,
# so the server refuses to boot until you generate your own.
# Generate with: openssl rand -base64 32
JWT_SECRET=

# Pepper for password hashing (minimum 32 characters). REQUIRED.
# It is mixed into every stored password hash through Argon2's native `secret` parameter
# and never written to the database, so a leaked database alone is still not crackable.
# Left empty on purpose, for the same reason as JWT_SECRET.
# 🔴 Changing it — or losing it — makes **every** stored password fail to verify. Users can
# still sign in with a passkey or an email link and then set a new password.
# Generate with: openssl rand -base64 32
PASSWORD_PEPPER=

# PostgreSQL password for the database. REQUIRED.
# Left empty on purpose; postgres refuses to initialize without it.
# Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=

# Public URL of this server, with protocol. REQUIRED.
# Used for the links in verification / magic-link / recovery emails, so it must be
# reachable by your users, not by the container. It MUST start with https:// when
# NODE_ENV=production (the default in Docker) — the server refuses to boot otherwise.
PUBLIC_URL=https://sync.your-domain.com

# =============================================================================
# PASSKEY / WEBAUTHN SETTINGS (required for passkey login)
# =============================================================================

# Relying-party ID: your domain, WITHOUT protocol or port. Passkeys are bound to
# this value, so changing it later invalidates every credential already registered.
WEBAUTHN_RP_ID=sync.your-domain.com

# Where users reach the auth UI, WITH protocol. Normally the same as PUBLIC_URL.
WEBAUTHN_ORIGIN=https://sync.your-domain.com

# Name shown in your users' OS passkey prompt. Defaults to WEBAUTHN_RP_ID.
# WEBAUTHN_RP_NAME=Your Service Name

# =============================================================================
# SERVER SETTINGS (optional - defaults provided)
# =============================================================================

# Server bind address (default: 0.0.0.0)
# Use :: for IPv6-only deployments.
HOST=0.0.0.0

# Host port compose publishes the API on (default: 1900). The container-side port
# is fixed at 1900 -- `PORT` above is not this knob, and changing it breaks the
# health check and the internal Caddy -> app hop.
#
# This exists because the mapping is bound to 127.0.0.1 on purpose (the app is
# reachable from outside only through Caddy or your own reverse proxy). Running a
# second stack on the same machine therefore needs a different host port, not a
# different `PORT`.
# SUPERSYNC_HOST_PORT=1900

# Restrict who may register, as a comma-separated list of exact addresses and/or
# *@domain rules. Unset means anyone who can reach the server may register.
# ALLOWED_EMAILS=you@example.com,*@your-domain.com

# Per-user storage quota in bytes (default: 104857600 = 100 MB). This default
# applies to accounts created from now on; existing accounts keep the quota they
# were created with.
# SUPERSYNC_DEFAULT_STORAGE_QUOTA_BYTES=104857600

# =============================================================================
# SHARED WEB CLIENT (optional - the shipped image already serves it)
# =============================================================================

# heyta's own web UI is built into the server image and served by THIS process,
# so one `docker compose up` gives you API + UI on the same origin:
#
#     https://<DOMAIN>/app/
#
# Nothing to configure for that. Both values below are knobs for the two cases
# where you want something different — they are NOT a master switch you have to
# remember to turn on, and leaving this whole section untouched is the norm.
#
# Why the switch is "is the directory there" instead of a `*_ENABLED` boolean:
# a boolean that is on while the directory is missing yields a server that boots
# fine, answers /health with 200, and 404s the UI — the failure is silent.
# Both states are logged at info level at startup instead.

# Where the built UI lives inside the container (default: /app/web-dist).
# Set it to an EMPTY value to serve API only, or point it at your own build:
#   docker run -v ./my-dist:/srv/my-dist:ro -e WEB_APP_DIR=/srv/my-dist …
# Must be an absolute path; a relative one is rejected at startup (it would
# otherwise depend on the working directory, which is different under systemd).
# WEB_APP_DIR=/app/web-dist

# Path prefix the UI is mounted on (default: /app/). Leading AND trailing slash
# required, and it must not collide with /api, /health, /live, /ws or the site
# root — a collision is a startup error, not a silent fallback.
#
# 🔴 This must match how the UI was BUILT. The prefix is baked into index.html's
# asset URLs, the PWA manifest's start_url/scope, and the service worker URL, so
# mounting a /app/-built UI at /ui/ yields a blank page whose stylesheet requests
# return HTML. The image's build runs scripts/check-web-artifact.mjs to catch
# exactly that; if you serve your own build, check it the same way.
# WEB_APP_PATH=/app/

# =============================================================================
# DATABASE SETTINGS (optional - defaults provided)
# =============================================================================

# PostgreSQL user (default: supersync)
# POSTGRES_USER=supersync

# PostgreSQL database name (default: supersync)
# POSTGRES_DB=supersync

# Memory cap for the bundled postgres container, and the planner hint that has
# to track it (defaults: 1536m / 1GB — the released values; raising is opt-in). These are ONE decision, not two: under
# cgroup v2 the page cache postgres reaches is charged to the cgroup, so this cap
# — not host RAM — bounds how much of the operations heap can stay cached.
# Lower BOTH on a small VPS. A cap at or above your whole host loses cgroup
# containment entirely: the HOST OOM killer then picks the victim, possibly sshd.
# Rule of thumb for the hint: (limit - shared_buffers), i.e. limit - 384MB.
# Raising both recreates the postgres container on the next `up -d`, dropping a
# warm page cache — schedule it, do not let it land mid-deploy.
# POSTGRES_MEM_LIMIT=2048m
# POSTGRES_EFFECTIVE_CACHE_SIZE=1536MB

# External PostgreSQL connection string. Leave unset to use the bundled compose
# postgres service. The bundled service is reachable as postgres:5432; db:5432
# is also kept as a compatibility alias for older .env files. If you point this
# at an external host, also set POSTGRES_SERVICE= below.
#
# IMPORTANT: append ?connection_limit=N&pool_timeout=10 to bound Prisma's pool.
# Prisma's DEFAULT pool size is ~(host_cpu_count * 2), read from HOST cores —
# NOT the container cpu limit. On a many-core host an unbounded pool silently
# consumes the entire postgres max_connections cap (compose: 120), leaving zero
# headroom for psql, migrations, the old-ops cleanup job, or the reconnect
# stampede after a crash recovery -> "sorry, too many clients already" and a
# fleet-wide WS reconnect storm. Keep N well below max_connections (e.g. 60).
#
# Setting DATABASE_URL here REPLACES the compose default wholesale, so these
# params are not inherited — they must be carried across explicitly.
# DATABASE_URL=postgresql://supersync:password@example.com:5432/supersync?connection_limit=60&pool_timeout=10
#
# OPTIONAL RECOVERY GUARDRAIL — enable only after checking legacy histories:
#   ...&options=-c%20statement_timeout%3D60000
# Without it a single degenerate query plan holds a pool connection until someone
# kills it by hand: 75 minutes in the 2026-07-20 outage, which consumed the whole
# pool and failed every user's sync, including requests unrelated to the bad
# query. Prisma's transaction timeout only aborts the client side; the backend
# keeps running. This is what makes pool exhaustion recoverable rather than a
# state the server cannot exit on its own, and it was absent in all three
# operations-table incidents. Only the connection-string form works — Prisma
# overrides both ALTER ROLE and ALTER DATABASE statement_timeout. Keep the
# shown %20 (space) and %3D (=) encoding for portability across URL tooling.
#
# NOT enabled by default because one legacy path legitimately exceeds 60s:
# `_computeSnapshotVectorClock` (src/sync/services/operation-download.service.ts)
# aggregates the vector clock across a user's whole history, and was moved out of
# its transaction because large histories trip the 60s transaction budget. It
# runs when persisted snapshot-clock metadata is missing, stale, or invalid. On
# upgraded instances with long histories, a 60s cap can turn those downloads into
# deterministic 500s. Either confirm that fallback no longer fires for your users,
# or set a budget above its worst case. (#9191)
#
# scripts/migrate-deploy.sh replaces this cap for the migrator with a finite
# statement timeout five seconds below MIGRATE_STEP_TIMEOUT, allowing long
# CREATE INDEX CONCURRENTLY work without leaving an unbounded backend query.
#
# The monitoring scripts replace it too (scripts/monitoring-db.ts): fleet-wide
# reports are not user-facing, so they run under MONITOR_STATEMENT_TIMEOUT_MS
# (default 300000) and identify themselves as application_name
# 'supersync-monitor' so health-alert.sh does not page about a long report.
# MONITOR_STATEMENT_TIMEOUT_MS=300000

# =============================================================================
# CORS SETTINGS
# =============================================================================

# CORS allowed origins (comma-separated)
# Default: https://app.super-productivity.com
# Add your self-hosted frontend URL if applicable.
# Subdomain wildcards are supported: https://*.example.com
# Do NOT use "*" in production: CORS runs with credentials: true, so a wildcard
# reflects any origin and lets any site make authenticated requests on a user's behalf.
#
# You do NOT need an entry here for the web UI this container serves itself
# (see SHARED WEB CLIENT above): it is same-origin, so no preflight happens and
# nothing is checked. Leave this at its default and it stays a no-op for you.
CORS_ORIGINS=https://app.super-productivity.com

# =============================================================================
# SMTP CONFIGURATION (Required for email verification)
# =============================================================================

# SMTP server hostname
SMTP_HOST=smtp.your-email-provider.com

# SMTP port (default: 587 for TLS, 465 for SSL)
SMTP_PORT=587

# Use SSL/TLS (true for port 465, false for STARTTLS on 587)
SMTP_SECURE=false

# SMTP authentication credentials
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password

# From address for emails
SMTP_FROM="Super Productivity Sync <noreply@your-domain.com>"

# =============================================================================
# LEGAL PAGES (optional — but see the warning below)
# =============================================================================
#
# The image ships NO Terms of Service and generates NO privacy policy until you
# identify yourself here as the data controller. That is deliberate: a policy
# naming someone else's hosting provider, or asking your users to accept terms
# under German law, would be a false legal statement published in YOUR name.
#
# Set ALL FIVE to publish /privacy.html and show the registration consent notice.
# Set none and the legal pages are simply not served. Setting some but not all is
# a startup error, not a silent fallback.
#
# PRIVACY_CONTACT_NAME=Your Name or Company
# PRIVACY_ADDRESS_STREET=Example Street 1
# PRIVACY_ADDRESS_CITY=12345 Example City
# PRIVACY_ADDRESS_COUNTRY=Germany
# PRIVACY_CONTACT_EMAIL=contact@your-domain.com

# Optional: your hosting provider, if a third party processes the data on your
# behalf. Omitted from the policy entirely when unset. Newlines become line
# breaks, so a full address block works here.
# PRIVACY_HOSTING_PROVIDER=Example Hosting GmbH, Example Street 1, 12345 City, Germany

# Optional: the data-protection supervisory authority competent for you. When
# unset, the policy points users to the authority for their own residence.
# PRIVACY_SUPERVISORY_AUTHORITY=Your State Data Protection Commissioner, https://example.gov/

# Optional: where your instance stores user data. Set to EU (or EEA) to show the
# "Data hosted in EU" badge on the landing page. Any other value shows no badge —
# an EU flag above "hosted in the US" is exactly the kind of false claim the legal
# pages were reworked to avoid. State your actual location in the privacy policy.
# PRIVACY_DATA_REGION=EU

# To publish your own Terms of Service, place the HTML at <DATA_DIR>/legal/terms.html
# — it is copied to /terms.html at startup and linked from the consent notice.

# For deployments driven by scripts/deploy.sh: set to true to sync legal/terms.html
# from the git checkout into the data volume on every deploy, making the repository
# the source of truth. Only set this if that file really is YOUR terms — on a stock
# checkout it is the hosted instance's ToS under German law.
# SUPERSYNC_INSTALL_REPO_TERMS=true

# =============================================================================
# SUBSCRIPTION ENTITLEMENTS (official hosted instance ONLY — leave OFF self-hosting)
# =============================================================================
#
# 会员订阅闸门。**默认关**。关着的时候服务端**一次数据库都不查**、直接放行。
#
# 🔴 这是一个"我运营的是官方托管实例，用户必须订阅才能用托管同步"的开关。
#    自托管**不要开**：heyta 是 MIT、自托管免费，这是项目的立身之本
#    （docs/plans/subscription-boundary.md §1）。开了之后，你自己的用户会
#    因为没有订阅而被拒绝 —— 而自托管者根本不应该向任何人收费或校验订阅。
#
# 为什么需要显式开关而不是自动判断：代码里**没有**任何"官方实例 vs 自托管"的
# 程序化标志。域名、CORS 默认值、是否有法律文本都不能用来推断 —— 那种推断会在
# 自托管者身上误伤。所以只有你亲手打开它，闸门才存在。
#
# 只接受 true / false；写别的值会在启动时报错（不会静默变成关闭）。
# ENTITLEMENT_GATE_ENABLED=false

# =============================================================================
# ACCOUNT ACTIVATION — 是否必须点过验证邮件里的链接
# =============================================================================
#
# **默认 true**（= 不写这一行就是现在的行为：注册后要收那封信才激活）。
#
# 🔴 什么时候需要把它改成 false：**你自托管，而这台服务器发不出邮件**。
#    没配 SMTP 时 `sendEmail` 会失败（生产模式下直接报错），而 `isVerified` 是
#    **所有**登录路的硬前置 —— 邮箱+口令那条路更是在口令校验通过之后才拒绝，
#    所以症状是"注册说成功了、口令却永远登录不进"，而且界面上每一句"请查收邮件"
#    都指向一封从来没存在过的信。关掉这一步之后，注册**当场**就能用口令登录。
#
# ⚠️ 代价（这是关掉的真正含义，不是措辞）：从此没有任何东西证明"这个人收得到
#    那个邮箱"。任何人都能用任意邮箱建号，找回密码也就会寄到别人手里。
#    所以它只适合"这台服务器只给自己/自己人用"的部署；面向公众的实例
#    请配 SMTP（下面的 SMTP_HOST 那一节），而不是关这道门。
#
# 只接受 true / false；写别的值会在启动时报错（不会静默变成任何一边）。
# 关掉时服务端日志会打一行 `[REQUIRE_EMAIL_VERIFICATION=false] Activated ...`，
# 那行是留给运维的：它出现在一台你以为在发信的服务器上，就是配置漂移。
# REQUIRE_EMAIL_VERIFICATION=true

# =============================================================================
# WECHAT PAY — Native QR checkout (official hosted instance ONLY; leave OFF self-hosting)
# =============================================================================
#
# 微信支付（Native 扫码）。**默认关**：关着的时候微信 adapter 根本不注册，
# `POST /api/billing/webhooks/wechat` 回 404，自托管实例的行为与没有这个功能时
# **逐字相同**。只有 `WECHAT_PAY_ENABLED=true` **且**下面六个 WX_* 全部齐全，
# adapter 才会注册；少任何一个都是**启动期硬错误**，不是静默降级
# （"看起来配了但注册不上"会表现为"用户付了钱但没有权益"，那是最坏的静默）。
#
# 🔴 这里是**运营者**的配置：只有官方托管实例需要收"托管同步服务"的费用
#    （docs/plans/subscription-boundary.md §6）。自托管不要开。
#
# 🔴 凭证**绝不要提交进仓库**。真实值只放本地 `.env`（已在 .gitignore 里）。
#    这里只列变量名与占位符。
#
# 只接受 true / false；写别的值会在启动时报错。
# WECHAT_PAY_ENABLED=false
#
# 微信支付商户平台（普通商户）：
# WX_APP_ID=wx0000000000000000
# WX_MCH_ID=1900000000
# WX_SERIAL_NO=商户API证书序列号（40 位十六进制）
# WX_API_V3_KEY=32位APIv3密钥
# WX_PRIVATE_KEY=商户API私钥（PEM，或 PEM 的 base64；换行也可以写成 \n）
# WX_PUBLIC_KEY=微信支付平台公钥（PEM，或 PEM 的 base64）
#
# 回调地址。可选：留空时由 PUBLIC_URL 推导为
# `<PUBLIC_URL>/api/billing/webhooks/wechat`。必须是**微信能访问到的**
# https 地址（微信拒绝非 https 的 notify_url）。
# WX_NOTIFY_URL=https://sync.your-domain.com/api/billing/webhooks/wechat

# =============================================================================
# CONTAINER IMAGE (and the registry, for build-and-push.sh)
# =============================================================================

# 🔴 heyta **没有发布任何镜像**，所以这里没有"官方镜像可以拉"。默认值 `supersync:local`
# 指的是**你在自己机器上构建出来的那一枚**（构建入口见 docs/runbooks/self-host.md §3/§4）。
#
# 不要把这里指向上游 Super Productivity 的 `ghcr.io/super-productivity/supersync:latest`
# 或 `master-<sha>`：那是**另一个项目的服务端**，它的数据表结构与加密要求早已和 heyta 分开。
# 照做的后果不是报错，是一台**能正常启动、健康检查也通过、跑的却是陌生表结构**的服务器。
# 要钉版本就从本仓库源码构建，并把那份源码的提交号当成你给自己的 tag。
#
# 设了它，应用容器与一次性迁移容器会**同时**用它（两边读同一个表达式）。
# SUPERSYNC_IMAGE=ghcr.io/your-name/heyta-server:<你的 tag>

# GitHub username for GHCR
# GHCR_USER=your-github-username

# Namespace build-and-push.sh publishes to. Defaults to super-productivity, which
# you cannot push to — set this to your own account or org.
# GHCR_NAMESPACE=your-github-username

# GitHub token. Pushing (build-and-push.sh, from your workstation) needs
# "Packages: Read and write"; a token that only has to pull on the deploy host
# should be read-only. Do not put a write-capable token in a server's .env.
# Create at: https://github.com/settings/tokens?type=beta
# GHCR_TOKEN=your-github-token

# =============================================================================
# ADVANCED SETTINGS (usually no changes needed)
# =============================================================================

# Log level (info, debug, warn, error)
# LOG_LEVEL=info

# Startup migrations are disabled by default. Use scripts/deploy.sh for
# production and local Docker deploys so migrations run once before the app
# container is replaced. Only set this to true for one-off/manual runs.
#
# If you want bare compose to be enough without turning this on, opt into the
# one-shot migrator instead — it is the same shape as the Helm chart's migrate-db
# init container, and it does NOT change the default service graph.
# The command to copy lives in exactly one place: docs/runbooks/self-host.md §4
# (and its English twin in README.md). It needs BOTH overrides — dropping
# docker-compose.build.yml leaves compose with no image to run and no build
# definition, and the resulting error tells you to 'docker login' at a registry
# that does not exist. Do not retype it here; a fourth copy is how that happened.
# See docker-compose.migrate-once.yml for why it only migrates on first boot.
# RUN_MIGRATIONS_ON_STARTUP=false

# Compose service used for database readiness checks. Leave unset to use the
# bundled postgres service. Set POSTGRES_SERVICE= to an empty value only when
# DATABASE_URL points to an external database; deploy.sh will then start
# supersync/caddy without compose dependencies. Prisma migrations still run
# against the configured DATABASE_URL.
# POSTGRES_SERVICE=

# Old operation retention cleanup deletes in bounded batches so a backlog cannot
# monopolize PostgreSQL. Increase carefully on larger servers.
# BATCH_SIZE is a serverSeq WINDOW width per DELETE statement (which also caps
# the rows one statement can delete) — the stated range is what keeps each
# statement inside statement_timeout regardless of history state (#9692).
# OLD_OPS_CLEANUP_DELETE_BATCH_SIZE=5000
# OLD_OPS_CLEANUP_MAX_DELETED_PER_RUN=25000
#
# DIGGING OUT OF A BACKLOG. The per-run budget is sized for steady state — one
# day's aged ops — not for catching up after retention has been failing, and the
# sweep runs ONCE PER DAY, so the default clears 25k/day (a 4.4M-row backlog is about
# six months at that rate). Size a temporary raise
# against the real number with `npm run dry-run-old-ops-sweep` (read-only), then
# put it back — see MONITORING-README.md "Digging out of an ops backlog" for the
# signals to watch while it drains.

# Timeout in seconds for `prisma migrate deploy` during ./scripts/deploy.sh.
# Online index builds (CREATE INDEX CONCURRENTLY) can block on long-running
# transactions; raise this for very large tables (3600 is a safe starting point
# for a large operations table — the 900 default can SIGTERM a slow index build
# part-way through). A timed-out migrator container is now force-removed, so a
# too-low value no longer wedges the NEXT deploy with a leaked advisory lock
# (P1002); the deploy fails loudly with copy-paste recovery steps instead. Note
# an interrupted CREATE INDEX CONCURRENTLY can still need a one-time INVALID-index
# drop (the failure output prints the exact steps) before the re-run succeeds.
# Exit code 124 = timed out.
# MIGRATION_TIMEOUT=900

# Per-migration-step timeout (seconds) enforced inside the image. deploy.sh
# derives it from MIGRATION_TIMEOUT (minus a small margin) and forwards it, so
# raising MIGRATION_TIMEOUT is enough for the deploy.sh path. Set this directly
# only for the image CMD / helm initContainer paths, which have no outer host
# timeout. Defaults to 1800 inside the image when unset.
# MIGRATE_STEP_TIMEOUT=

# Safety valve for custom/private images without an
# org.opencontainers.image.revision label. Leave this unset in production; the
# deploy script uses the label to prevent mixing fresh SuperSync deploy inputs
# with a stale supersync image.
# SUPERSYNC_SKIP_IMAGE_REVISION_CHECK=false

# ── Image sources (only needed when Docker Hub / Alpine / npm are unreachable) ──
# All five are optional and default to the official reference, so leaving them
# unset changes nothing. They are split by **which stage** pulls:
#   build time  — APK_MIRROR, NPM_REGISTRY, NODE_IMAGE (read by docker-compose.build.yml)
#   run time    — POSTGRES_IMAGE, CADDY_IMAGE (read by docker-compose.yml below)
# A build-time knob cannot rescue an image that `up` pulls later, which is why the
# two below exist separately. `check:image-build-args` rule R6 fails if any
# `image:` in server/docker-compose*.yml stops being `${NAME:-default}` shaped.
# POSTGRES_IMAGE=postgres:16-alpine
# CADDY_IMAGE=caddy:2.11-alpine
