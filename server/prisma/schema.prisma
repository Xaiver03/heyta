// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                            Int      @id @default(autoincrement())
  email                         String   @unique
  passwordHash                  String?  @map("password_hash") // Nullable for passkey-only users
  isVerified                    Int      @default(0) @map("is_verified") // 0 or 1
  // 🔴 下面四对令牌列存的都是**令牌本身的 SHA-256（hex）**，不是发进邮件的那句话。
  // 理由与"为什么这里不用 Argon2"都在 server/src/auth-tokens.ts；读写必须过
  // 那一个 `hashToken()`，少包一次的症状不是报错而是"用户点邮件链接说链接已过期"。
  // 存量明文已由 20261005000000_invalidate_stored_auth_tokens 一并作废。
  // ⚠️ 这个立场只对**CSPRNG 生成的高熵一次性凭证**成立：若将来某列存的是人抄的
  // 低熵恢复码，只存 SHA-256 不够（库里那份能当场穷举），要限次 + 短 TTL。
  verificationToken             String?  @map("verification_token")
  verificationTokenExpiresAt    BigInt?  @map("verification_token_expires_at")
  verificationResendCount       Int      @default(0) @map("verification_resend_count")
  // 口令找回（W3，`password/recovery.ts`）用的**一次性令牌**：SHA-256 hex，理由同上一列。
  // ⚠️ 这一列只有普通索引、**没有** `@unique`（上游的 `auth_tokens` 形状，改它要迁移），
  // 所以"这一枚令牌属于哪一行"由 `recovery.ts` 里那条**带条件的 `updateMany`** 保证，
  // 不是靠"库里查不到第二条"。
  resetPasswordToken            String?  @map("reset_password_token")
  resetPasswordTokenExpiresAt   BigInt?  @map("reset_password_token_expires_at")
  passkeyRecoveryToken          String?  @map("passkey_recovery_token")
  passkeyRecoveryTokenExpiresAt BigInt?  @map("passkey_recovery_token_expires_at")
  loginToken                    String?  @map("login_token")
  loginTokenExpiresAt           BigInt?  @map("login_token_expires_at")
  failedLoginAttempts           Int      @default(0) @map("failed_login_attempts")
  lockedUntil                   BigInt?  @map("locked_until")
  tokenVersion                  Int      @default(0) @map("token_version")
  // 运营管理后台的准入标记。**单级**：没有角色表、没有权限码（ADR-0038 §2 二 / §3.1）。
  // 默认 false ⇒ **没有人生来是管理员**；授权只能由 CLI 或已有管理员显式做（fail-closed）。
  isAdmin                       Boolean  @default(false) @map("is_admin")
  termsAcceptedAt               BigInt?  @map("terms_accepted_at")
  // 同意留痕的版本指针：形如 `terms@1.0;privacy@1.0;…` 的**整套**文本版本指纹
  //（`@heyta/legal` 的 `legalSetVersion()`）。对外文本两处承诺了它
  //（`terms.ts` 的「同意留痕」条、`privacy.ts` 第 12 条），承诺的形状是
  // "一整套版本号一起钉住"，所以这里是一列字符串，不是一行一份文档。
  //
  // 🔴 **可空，且老账号不回填**：`null` 的含义是"只有时间戳、无法证明是哪一版"，
  // 这批账号要走补签。回填版本 = 发明同意（AGENTS §3.3 与
  // `docs/plans/user-journey-and-auth.md` 那条"不得替用户预勾或发明同意"是同一条纪律）。
  // 另一层含义：非官方托管实例发布的是**运营者自己**的文本，它的版本我们无法命名，
  // 所以那台实例上的记录同样是 `null`（裁决见 legal-consent.ts）。
  termsDocumentVersion          String?  @map("terms_document_version")
  createdAt                     DateTime @default(now()) @map("created_at")
  storageQuotaBytes             BigInt   @default(104857600) @map("storage_quota_bytes") // 100MB default
  storageUsedBytes              BigInt   @default(0) @map("storage_used_bytes")
  // 账号语言（可空）：登录态下用户改界面语言时写回；发信对已知账号优先用它。
  // 依据 docs/plans/i18n-multilingual.md §3 的四层解析链（2026-10-01 拍板）。
  // AGENTS §3.3：新增持久化字段一律可选 —— null = 用户从未在登录态下改过语言，
  // 邮件语言照旧走 请求显式 > 账号 > Accept-Language > zh-CN。
  locale                        String?
  // 账号资料（R10，2026-10-02 产品负责人裁决）。**明文**，与 `locale` 同一档：
  // 账号级、Bearer 归属、不参与 op-log 加密通道。
  //
  // 🔴 为什么昵称可以明文、而**头像不行**（见下面 `UserAvatar` 那段）：
  // 这两件事常被混成一句"反正都是 profile"，但它们对的是**不同的行**。
  // `packages/legal` 的表 E 是**逐项**对照《个人信息保护法》第二十八条那个列举
  //（生物识别 / 宗教信仰 / 特定身份 / 医疗健康 / 金融账户 / 行踪轨迹 / 未成年人）——
  // 昵称不在那个列举里，也不与任何一行的"不收集"依据冲突；
  // 而**人脸照片命中"生物识别"那一行**，那一行的依据是**结构性**的
  //（原文："没有任何生物特征模板离开你的设备"）。
  // ⇒ 同一张资料页里一个走明文、一个必须走密文，**不是一致性瑕疵，是两行不同的承诺**。
  //
  // 对外文本这边还有一条要一起看：`privacy.ts` 第 2 条写的本来就是
  // 「端到端加密覆盖**内容**，不覆盖元数据」，并且那里明确**不写**
  // "服务端完全看不到你的任何数据"那句绝对化的话 —— 所以加明文昵称**不产生虚假陈述**。
  // 但那一节数过的「明文元数据一共 11 项」是逐表逐列取证来的
  //（`docs/research/legal-dataflow-client.md` A1/A2），🔴 **要跟着这一笔一起改**，
  // 不许下次再补。归 docs/plans/ui-review-fill-zh-timeline.md §8.7 的收尾清单。
  //
  // ⚠️ **今天它只有本人能读**：heyta 没有共享/协作（E2EE 下服务端解不开，结构上做不了），
  // 所以"全员可见"是为将来预留的属性、不是已存在的行为。
  // 读取端点一律 `preHandler: authenticate` + `getAuthUser(req)`，
  // **不许**出现按 id/email 查别人资料的公开端点 —— 那是一次独立的产品决定，
  // 不在本次裁决里（裁决原文见 docs/plans/ui-review-fill-zh-timeline.md §8.6）。
  //
  // 空 = 用户从未设置过 ⇒ 界面回落到邮箱派生的显示名（`displayNameFromEmail`，
  // 那是一份**只读**派生值，不是这一列）。
  displayName                   String?  @map("display_name")

  operations                  Operation[]
  syncState                   UserSyncState?
  devices                     SyncDevice[]
  revokedSyncDevices          RevokedSyncDevice[]
  vaultKeyPackage             VaultKeyPackage?
  vaultKeyMigrations          VaultKeyMigration[]
  passkeys                    Passkey[]
  pendingPasskeyRegistrations PendingPasskeyRegistration[]
  subscriptions               Subscription[]
  checkoutOrders              CheckoutOrder[]
  couponRedemptions           CouponRedemption[]
  widgetPushSubscriptions     WidgetPushSubscription[]
  inviteCode                  InviteCode?
  referralsMade               Referral[]            @relation("ReferralInviter")
  referralReceived            Referral?             @relation("ReferralInvitee")
  notifications               AccountNotification[]
  consents                    UserConsent[]
  avatar                      UserAvatar?
  aiUsageCounters             AiUsageCounter[]

  @@index([verificationToken])
  @@index([resetPasswordToken])
  @@index([passkeyRecoveryToken])
  @@index([loginToken])
  @@map("users")
}

model Passkey {
  id           String    @id @default(cuid())
  credentialId Bytes     @unique @map("credential_id")
  publicKey    Bytes     @map("public_key")
  counter      BigInt    @default(0)
  transports   String? // JSON array of transport types
  name         String? // 用户自己起的名字；NULL = 没起过，界面回落到日期等既有信息
  createdAt    DateTime  @default(now()) @map("created_at")
  lastUsedAt   DateTime? @map("last_used_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("passkeys")
}

model PendingPasskeyRegistration {
  id                         String   @id @default(cuid())
  // 🔴 同样是 SHA-256 hex（见 User 上面那段与 server/src/auth-tokens.ts）。
  // @unique 在哈希下仍然成立：令牌是 256 位随机值，哈希只是它的另一个名字。
  // ⚠️ 这一列 NOT NULL ⇒ 清理迁移对这张表只能 DELETE，不能置 null。
  verificationToken          String   @unique @map("verification_token")
  verificationTokenExpiresAt BigInt   @map("verification_token_expires_at")
  credentialId               Bytes    @map("credential_id")
  publicKey                  Bytes    @map("public_key")
  counter                    BigInt   @default(0)
  transports                 String?
  createdAt                  DateTime @default(now()) @map("created_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("pending_passkey_registrations")
}

model Operation {
  id                  String   @id
  userId              Int      @map("user_id")
  clientId            String   @map("client_id")
  serverSeq           Int      @map("server_seq")
  actionType          String   @map("action_type")
  opType              String   @map("op_type")
  entityType          String   @map("entity_type")
  entityId            String?  @map("entity_id")
  // Entity set for multi-entity (batch) ops only — single-entity ops store [] and
  // are matched via the scalar `entityId` (the client sets `entityId` to entityIds[0]
  // but the server does not enforce that). Conflict detection consults this array so
  // writes to a non-first entity are not invisible across uploads (#8334).
  // Pre-migration rows have an empty array and fall back to `entityId` in the
  // conflict lookups, so the backfill is forward-only (older entities 2..n are
  // unrecoverable — they were never persisted).
  entityIds           String[] @default([]) @map("entity_ids")
  payload             Json
  payloadBytes        BigInt   @default(0) @map("payload_bytes")
  vectorClock         Json     @map("vector_clock")
  schemaVersion       Int      @map("schema_version")
  clientTimestamp     BigInt   @map("client_timestamp")
  receivedAt          BigInt   @map("received_at")
  isPayloadEncrypted  Boolean  @default(false) @map("is_payload_encrypted")
  syncImportReason    String?  @map("sync_import_reason")
  repairBaseServerSeq Int?     @map("repair_base_server_seq")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, serverSeq])
  @@index([userId, entityType, entityId, serverSeq])
  // Covering: serverSeq trails so the old-ops fresh-prefix probe answers its
  // server_seq filter from the index tuple (index-only NO answers, #9692).
  @@index([userId, receivedAt, serverSeq])
  // Multi-entity conflict lookups (#8334) probe entity_ids with @> / &&. This MUST stay
  // modelled here, not only in the 20260613000001 raw migration: `prisma db push` builds
  // from this file alone, so while the GIN existed only as raw SQL the CI, E2E and
  // documented manual-setup databases had NO index at all — and detectConflictForEntity's
  // MATERIALIZED CTE carries no user_id predicate, so without it every probe Seq Scans
  // EVERY tenant's rows, twice per accepted op. Worse than the outage this replaced.
  // The map name matches the raw migration, so migrate-based deployments see no drift.
  @@index([entityIds], type: Gin, map: "operations_entity_ids_gin")
  // Two raw PARTIAL indexes on op_type live outside this file, because Prisma has no
  // partial-index syntax: the BROAD 3-value one (20260512000000) that restore-point
  // lookups and the legacy-REPAIR queries need, and the CAUSAL one (20260829000000)
  // whose predicate matches CAUSAL_FULL_STATE_OPERATION_WHERE verbatim so the old-ops
  // sweep's fleet-wide boundary scan runs index-only. Both are additive and both must
  // exist; see 20260829000000 for why the broad one must not be tightened in place.
  // db-push databases get NEITHER. Same trap, different indexes; tracked in #9192.
  @@map("operations")
}

model UserSyncState {
  userId                     Int     @id @map("user_id")
  lastSeq                    Int     @default(0) @map("last_seq")
  lastSnapshotSeq            Int?    @map("last_snapshot_seq")
  snapshotData               Bytes?  @map("snapshot_data")
  snapshotAt                 BigInt? @map("snapshot_at")
  snapshotSchemaVersion      Int?    @default(1) @map("snapshot_schema_version")
  latestFullStateSeq         Int?    @map("latest_full_state_seq")
  latestFullStateVectorClock Json?   @map("latest_full_state_vector_clock")
  latestStateReplacementSeq  Int?    @map("latest_state_replacement_seq")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_sync_state")
}

/// 会员订阅（**服务端表，不是 op**）。
///
/// 它回答的是"这个账号有没有资格使用官方托管服务"，与客户端 op-log 无关 ——
/// 订阅关系**绝不允许**走 op-log（`AGENTS.md §3.4`）：它不是用户意图，
/// 也不可能让用户离线自增。字段形状照现有模型：`@@map` 表名、snake_case 列名、
/// `userId Int` + `onDelete: Cascade`，时间戳用 `BigInt`（与 `User.termsAcceptedAt` 一致）。
///
/// 🔴 每一列都可选或带默认值（`AGENTS.md §3.3`）：老 `users` 行没有这些列，
/// 而且这里刻意不设任何"必填且无默认"的字段。
/// 🔴 本表**不参与** `CURRENT_SCHEMA_VERSION` —— 那管的是客户端 op-log / 快照的线协议。
model Subscription {
  id Int @id @default(autoincrement())

  /// 权益来源（支付商 / 渠道名，例如 `stripe`、`paddle`、`manual`）。
  provider String?

  /// 外部订阅 id，由支付商侧唯一标识一条订阅；webhook 幂等依赖它。
  /// 可空：手动授予 / 尚未绑定外部 id 的行没有它，PostgreSQL 的
  /// `UNIQUE` 允许多个 `NULL`，所以可空唯一约束不会互相冲突。
  externalSubscriptionId String? @unique @map("external_subscription_id")

  /// 🔴 **买的是哪一档** —— SKU id（`hosted-monthly` / `hosted-ai-monthly`）。
  ///
  /// 存在的理由：在此之前 `Subscription` 只有"有没有一条活跃订阅"这一维，
  /// 于是 ¥5 与 ¥12 **落成同一行、完全无法区分** —— 用户付 ¥12 拿到的
  /// 和 ¥5 一模一样，且没有任何代码能发现自己发错了货。
  ///
  /// 可空是刻意的（AGENTS.md §3.3）：手工授予、以及本列出现之前的老行没有它。
  /// `null` 不等于"没买过"，只等于"不知道该档位"—— 判定走 `grants`，不走本列。
  priceId String? @map("price_id")

  /// 🔴 **这一行实际授予的能力**（`hosting` / `ai`），是 `priceId` 对应档位的
  /// 能力投影（`docs/reference/pricing-and-entitlements.md` 的 `pricing-ssot` 块）。
  ///
  /// 为什么把派生值**存下来**，而不是每次去问价目表：
  /// 1. 运营改价目表不该**追溯**改变已经付过钱的用户拿到什么 —— 付了 ¥5 的人
  ///    不会因为明天 `hosted-monthly` 多送一项能力就凭空得到它（反之，也不会
  ///    因为某档位被砍而当场失去已付费的能力）；
  /// 2. 判定要能在**没有计价层**的进程里做（同步闸门只读这一行）。
  ///
  /// 空数组 = **没有任何能力**。它不是"全部"、也不是"未知"：未知必须是
  /// `null` 那一维的事，而这里能拿到的只有确切的集合。fail-closed。
  grants String[] @default([])

  /// `active` / `past_due` / `canceled` / `expired` 之类。可空，未知即视为无权益。
  status String?

  /// 当前周期结束时间（epoch 毫秒）。可空：无法确定周期时按"无权益"处理。
  currentPeriodEnd BigInt? @map("current_period_end")

  /// 🔴 **已应用事件中最大的 `occurredAt`**（epoch 毫秒），可空 = 还没有可比较的基线。
  ///
  /// 为什么必须单独存它：支付商的投递**不保证顺序**（见
  /// `docs/plans/subscription-provider-selection.md` §5），所以"取消"事件完全可能
  /// 晚于"续费"事件到达，而它的事件时间更早。判定新旧只能用**事件内的时间戳**，
  /// 不能用到达顺序，也不能用 `updatedAt`（那记录的是我们写入的时刻，
  /// 恰好正是被乱序颠倒的那个东西）。可空且无默认值是刻意的：老行没有它，
  /// 等同"没有基线"，一律允许应用（`AGENTS.md §3.3`）。
  lastEventAt BigInt? @map("last_event_at")

  /// 创建 / 更新时间（epoch 毫秒）。带默认值，避免任何"必填无默认"的列。
  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 反向关系：这条订阅上收到过的支付事件。只为满足 Prisma 的关系双端存在，
  /// 不参与任何"到期 / 退款 → 删除订阅"的级联（见 `PaymentEvent` 的 `onDelete: SetNull`）。
  paymentEvents PaymentEvent[]

  @@index([userId])
  @@map("subscriptions")
}

/// 支付事件 = **webhook 幂等闸门**。
///
/// 🔴 幂等唯一可靠的落点就是这里的 `@@unique([provider, providerEventId])`：
/// 七家支付商有四种互不相同的机制（Stripe `Idempotency-Key`、PayPal
/// `PayPal-Request-Id`、支付宝/微信只有 `out_trade_no`、Paddle **官方明确不支持**
/// 客户端幂等键），没有一种能把去重推给支付商。所以闸门必须建在我们自己的库上。
///
/// 🔴 **绝不存原始 webhook payload。** 里面可能含买家的邮箱 / 姓名 / 地址等 PII，
/// 而我们对它的全部需求只是"审计 + 去重" —— 存 `payloadDigest`（SHA-256 十六进制）
/// 就够了。这条是有意的，不要为了"方便排查"把原文加回来。
model PaymentEvent {
  id Int @id @default(autoincrement())

  /// 支付商标识（例如 `paddle` / `creem` / `noop`）。复合唯一键的一半。
  provider String

  /// 支付商侧的事件 id。复合唯一键的另一半。
  ///
  /// 🔴 唯一键是 **`(provider, providerEventId)` 复合**，不是单列：
  /// 不同 provider 用同一个 eventId 是两件事，不能互相判成重复。
  providerEventId String @map("provider_event_id")

  /// 归一化后的事件类型（adapter 的私有词表映射到这里的值）。可空。
  eventType String? @map("event_type")

  /// 🔴 原始 payload 的**哈希**（SHA-256 十六进制），不是原文。见上方 model 注释。
  payloadDigest String? @map("payload_digest")

  /// 事件发生时间（epoch 毫秒），取自 payload 内部，**不是到达时间**。
  /// 可空：某些事件确实没有时间戳。乱序判定以它为准（订阅行上的 `lastEventAt`）。
  occurredAt BigInt? @map("occurred_at")

  /// 收到时间（epoch 毫秒）。带默认值，避免"必填无默认"的列。
  receivedAt BigInt @default(0) @map("received_at")

  /// 处理完成时间（epoch 毫秒）。`null` = 已插入但尚未处理完。
  /// 处理失败时路由会**撤销该行**（见 `webhook.routes.ts` 的失败路径），
  /// 否则支付商重投会被判成重复而永远不再处理 —— 那会静默丢事件。
  processedAt BigInt? @map("processed_at")

  /// 关联的订阅行。可空：事件可能早于订阅创建，或该 provider 根本没有订阅状态机
  /// （支付宝 / 微信只有单次支付）。`onDelete: SetNull` —— 删订阅**不删事件审计**。
  subscriptionId Int?         @map("subscription_id")
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  /// 🔴 幂等的唯一可靠落点。
  @@unique([provider, providerEventId])
  /// 按 provider + 时间翻事件（运维排查用），不参与幂等判定。
  @@index([provider, receivedAt])
  @@map("payment_events")
}

model SyncDevice {
  clientId     String  @map("client_id")
  userId       Int     @map("user_id")
  deviceName   String? @map("device_name")
  userAgent    String? @map("user_agent")
  /// Bare semver the client last reported on download (`18.22.0`), NULL until
  /// it does. Read by the checkpoint gate (#9962); never shown to users.
  appVersion   String? @map("app_version")
  lastSeenAt   BigInt  @map("last_seen_at")
  /// Reserved: written once at device registration, never read or updated.
  lastAckedSeq Int     @default(0) @map("last_acked_seq")
  createdAt    BigInt  @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("sync_devices")
}

/// Tombstone for a clientId explicitly revoked by the account owner. Keeping
/// it separate from SyncDevice prevents a revoked offline client from
/// re-registering itself on its next upload.
model RevokedSyncDevice {
  userId    Int    @map("user_id")
  clientId  String @map("client_id")
  revokedAt BigInt @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, clientId])
  @@map("revoked_sync_devices")
}

/// Opaque E2EE key package. The server stores wrappers only; it cannot derive
/// or decrypt the vault root key. A new keyVersion is published after a
/// client-side rotation has re-encrypted every local record.
model VaultKeyPackage {
  userId              Int      @id @map("user_id")
  keyVersion          Int      @map("key_version")
  packageData         Json     @map("package_data")
  /// Null means this account has not completed the first payload migration.
  /// This is independent from key_version: changing a passphrase wrapper does
  /// not require rewriting operation ciphertext.
  activePayloadKeyVersion Int? @map("active_payload_key_version")
  createdAt           BigInt   @map("created_at")
  updatedAt           BigInt   @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("vault_key_packages")
}

/// Durable idempotency receipt for an atomic vault payload migration.
/// The request fingerprint is over opaque request metadata and ciphertext;
/// it never contains a plaintext key. A committed row is the recovery answer
/// when the HTTP response was lost after the database transaction committed.
model VaultKeyMigration {
  id                    String   @id @default(cuid())
  userId                Int      @map("user_id")
  requestId             String   @map("request_id")
  requestFingerprint    String   @map("request_fingerprint")
  state                 String   @default("STAGING")
  expectedKeyVersion    Int      @map("expected_key_version")
  expectedLatestSeq     Int      @map("expected_latest_seq")
  targetPayloadKeyVersion Int   @map("target_payload_key_version")
  keyVersion            Int      @map("key_version")
  latestSeq             Int      @map("latest_seq")
  expectedOperationCount Int     @default(0) @map("expected_operation_count")
  expectedPayloadBytes  BigInt   @default(0) @map("expected_payload_bytes")
  uploadedOperationCount Int    @default(0) @map("uploaded_operation_count")
  uploadedPayloadBytes  BigInt   @default(0) @map("uploaded_payload_bytes")
  reservedStorageBytes  BigInt   @default(0) @map("reserved_storage_bytes")
  migratedOperationCount Int    @default(0) @map("migrated_operation_count")
  expiresAt             BigInt   @map("expires_at")
  cancelledAt           BigInt?  @map("cancelled_at")
  packageData           Json     @map("package_data")
  createdAt             BigInt   @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  chunks VaultKeyMigrationChunk[]
  stagedOperations VaultKeyMigrationOperation[]

  @@unique([userId, requestId])
  @@index([userId, state, expiresAt])
  @@index([userId, createdAt])
  @@map("vault_key_migrations")
}

/// A bounded, retryable ciphertext chunk belonging to a staged migration.
/// Child operation rows make identity coverage and duplicate detection
/// relational rather than trusting a large JSON array at commit time.
model VaultKeyMigrationChunk {
  id                String   @id @default(cuid())
  migrationId       String   @map("migration_id")
  chunkId           String   @map("chunk_id")
  chunkIndex        Int      @map("chunk_index")
  requestFingerprint String  @map("request_fingerprint")
  operationCount    Int      @map("operation_count")
  payloadBytes      BigInt   @map("payload_bytes")
  createdAt         BigInt   @map("created_at")

  migration  VaultKeyMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  operations VaultKeyMigrationOperation[]

  @@unique([migrationId, chunkId])
  @@unique([migrationId, chunkIndex])
  @@index([migrationId, createdAt])
  @@map("vault_key_migration_chunks")
}

/// One staged replacement. It is opaque to the server apart from the public
/// envelope generation and is removed after publication/cancellation.
model VaultKeyMigrationOperation {
  id           String   @id @default(cuid())
  migrationId  String   @map("migration_id")
  chunkId      String   @map("chunk_id")
  operationId  String   @map("operation_id")
  serverSeq    Int      @map("server_seq")
  payload      Json
  payloadBytes BigInt   @map("payload_bytes")
  storageBytes BigInt   @map("storage_bytes")
  createdAt    BigInt   @map("created_at")

  migration VaultKeyMigration @relation(fields: [migrationId], references: [id], onDelete: Cascade)
  chunk     VaultKeyMigrationChunk @relation(fields: [chunkId], references: [id], onDelete: Cascade)

  @@unique([migrationId, operationId])
  @@unique([migrationId, serverSeq])
  @@index([migrationId, serverSeq])
  @@map("vault_key_migration_operations")
}

// ---------------------------------------------------------------------------
// 可调价 + 优惠券（见 docs/adr/0018-adjustable-pricing-and-coupons.md）
// ---------------------------------------------------------------------------
//
// 这五张表一起回答两个问题：
//   1. **这一刻收多少钱** —— `price_versions`（版本化价目表）+ `pricing_audit_log`；
//   2. **这一单收了多少、为什么是这个数** —— `coupons` + `checkout_orders` +
//      `coupon_redemptions`。
//
// 🔴 与 `CURRENT_SCHEMA_VERSION` **无关**：那个常量管的是客户端 op-log / 快照的
// 线协议版本（`packages/shared-schema/src/schema-version.ts`）。这五张表纯服务端，
// 不进线协议，客户端看不见它们。

/// 价目表的**一个版本**。改价 = 追加一版，**不是**就地改一行。
///
/// 为什么不用「一个可变的当前价 + 一张历史表」：那样"当前价"与"历史价"是两种
/// 形状的数据，每个读价格的地方都要判"读哪张表"，漏判的那处会静默地用当前价去
/// 解释一笔历史订单 —— 那是错账。统一成"区间"之后，当前价只是"区间包含 now 的
/// 那一版"，而历史订单能用**同一个函数**按它自己的时间点解析。
///
/// 区间是**左闭右开**（`effective_from` 含、`effective_until` 不含）：边界相接的
/// 两版不会同时生效，也不会留下空隙。两端都闭会让正常的改价操作触发"重叠"错误。
model PriceVersion {
  id Int @id @default(autoincrement())

  /// 价格标识（SKU）。与 `createCheckout` 的 `priceId` 同值，例如 `annual`。
  priceId String @map("price_id")

  /// `CNY` / `USD`。🔴 券与价格都按币种隔离，不做汇率换算。
  currency String

  /// 金额，**最小单位整数**（分 / 美分）。
  ///
  /// ⚠️ 用 `Int` 而不是 `BigInt`：`Int` 的上限是 ¥21,474,836.47，远超任何真实
  /// 定价，而它换来的好处是**这一列在 TS 里就是 `number`** —— 金额算术全程在
  /// `number` 上做（`money.ts` 只用整数运算），不需要在每次读价格时 `Number(bigint)`
  /// 转一次。那种转换正是"少转一次就静默算错"的位置。
  amountMinor Int @map("amount_minor")

  /// 生效起点（epoch 毫秒，**含**）。
  effectiveFrom BigInt @map("effective_from")

  /// 生效终点（epoch 毫秒，**不含**）。`NULL` = 一直有效（开区间）。
  effectiveUntil BigInt? @map("effective_until")

  /// 人类可读备注（进审计与运维输出）。例如「上线推广价」。
  note String?

  /// 写入时间与操作者。`createdBy` 是**字符串**而不是外键：改价可能由脚本、
  /// 运维或（将来）管理界面触发，把这些都强行绑到 `users` 上会让"系统自动调价"
  /// 这类来源无法表达。
  createdAt BigInt  @default(0) @map("created_at")
  createdBy String? @map("created_by")

  /// 按 (SKU, 币种) + 时间翻版本 —— 解析"这一刻哪一版生效"就走这个索引。
  @@index([priceId, currency, effectiveFrom])
  @@map("price_versions")
}

/// 定价域的**审计流水**：每一次改价、建券、停券都在这里留一行。
///
/// 为什么必须有：价格是**钱的账**。"某个用户在某个价格下买了东西"必须可回溯 ——
/// 只靠 `price_versions` 的区间能回答"当时的价格是多少"，但回答不了
/// 「**谁**在**什么时候**把它改成了这个价、改之前是什么」。这两件事都要有人能查。
///
/// 🔴 只追加，不更新、不删除。
model PricingAuditLog {
  id Int @id @default(autoincrement())

  /// 动作名（有界词表，见 `server/src/billing/pricing-store.ts` 的常量）。
  action String

  /// 作用对象，例如 `annual/CNY` 或券 id。
  target String

  /// 变更前后的快照（JSON 字符串）。改价时至少要有 `amountMinor`。
  beforeJson String? @map("before_json")
  afterJson  String? @map("after_json")

  /// 操作者（账号 / 脚本名 / `system`）。
  actor String?
  note  String?

  createdAt BigInt @default(0) @map("created_at")

  @@index([target, createdAt])
  @@index([action, createdAt])
  @@map("pricing_audit_log")
}

/// 一张**优惠券**：折扣的内容 + 适用范围 + 限额。
///
/// 券与优惠码在这里是**同一张表**（`code` 可空）：`code` 非空 = 用户可输入；
/// `NULL` = 只能由活动自动应用。Stripe 把两者拆成两张表（Coupon /
/// PromotionCode），那在"同一折扣要发给多个渠道、各自限额"时是必需的，
/// 而 heyta 现在只有一个渠道、一个 SKU —— 拆表带来的额外 join 与第二处限额校验
/// 大于它的收益。**触发拆表的条件**（出现任一即应拆）：
///   ① 同一折扣需要给 ≥2 个渠道各自独立的用量上限；
///   ② 需要"码级有效期 ≠ 活动级有效期"。
/// 见 `docs/adr/0018-adjustable-pricing-and-coupons.md` §3.3。
model Coupon {
  /// 稳定的券 id，**由运营指定**（例如 `launch-2026`），不是自增。
  /// 理由：它会写进订单与审计，一个会变的数字标识会让"这张订单用了哪张券"
  /// 在人工排查时无法与运营的口径对上。
  id String @id

  /// 用户可输入的码。🔴 **必须已归一化**（大写、无首尾空白），
  /// 归一化只在 `normalizeCouponCode()` 一个地方做。
  code String? @unique

  name String

  /// `percent` | `fixed`。与下面两个金额列构成判别联合，
  /// **由 `coupons_benefit_shape` 这个 CHECK 约束在数据库层强制**。
  kind String

  /// `kind = 'percent'` 时必填：基点（1bp = 0.01%）。`5000` = 5 折。
  percentOffBp Int? @map("percent_off_bp")

  /// `kind = 'fixed'` 时必填：减免金额（最小单位）。
  amountOffMinor Int? @map("amount_off_minor")

  /// 币种。🔴 `fixed` 券**必须**与订单同币种 —— 一张 ¥20 的券抵扣 $49 的订单
  /// 是资损，而且两种钱之间没有我们定义的汇率。
  currency String

  /// 适用的价格标识。
  ///
  /// ⚠️ Prisma **不支持可选的标量列表**（`String[]` 落库是 `NOT NULL DEFAULT '{}'`），
  /// 所以"全部适用"用**显式布尔列**表达，而不是拿空数组当哨兵 ——
  /// 后者会在 `[]` 究竟是"全部"还是"一个都不"上产生第二种约定。
  appliesToAllPrices Boolean  @default(true) @map("applies_to_all_prices")
  priceIds            String[] @map("price_ids")

  appliesToAllRegions Boolean  @default(true) @map("applies_to_all_regions")
  regions             String[] @map("regions")

  /// 生效窗口（epoch 毫秒）。`validUntil` 为 `NULL` = 永不过期。
  validFrom  BigInt  @map("valid_from")
  validUntil BigInt? @map("valid_until")

  /// 总核销上限。🔴 口径：**含"已预留未完成"**（见 `coupon_redemptions.state`）。
  /// 选这个口径是因为"占位"是主动攻击面（刷预留把名额占满），而"超发"是概率问题 ——
  /// 防前者优先。代价是 sweep 必须真的在跑，见 `pricing-store.ts`。
  maxRedemptions Int? @map("max_redemptions")

  /// 每个用户最多用几次。
  maxRedemptionsPerUser Int? @map("max_redemptions_per_user")

  /// 起用门槛：订单**原价**低于它就不能用。
  minimumOrderMinor Int? @map("minimum_order_minor")

  /// 拉新券：只有从未有过已支付订单的用户可用。
  firstPurchaseOnly Boolean @default(false) @map("first_purchase_only")

  /// 停用开关。🔴 停用是运营动作，**删除不是** —— 删券会让历史订单查不到它。
  enabled Boolean @default(true)

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  redemptions    CouponRedemption[]
  checkoutOrders CheckoutOrder[]

  @@index([enabled, validFrom])
  @@map("coupons")
}

/// 一笔**下单记录**：报价的快照 + 它后来的命运。
///
/// ## 🔴 这张表同时修掉了一个已知的洞
///
/// `docs/reference/pricing-and-entitlements.md` §4 记着：回调的金额校验原先只验
/// 「付的金额是价目表里的**某一个**」，那在只有一个 SKU 时恰好等价于"付对了"，
/// 一旦有第二个 SKU 或一张券就立刻失效。当时的计划是"把 priceId 编进订单号"。
///
/// 这里是**更强**的做法：整份报价（原价 / 折扣 / 实付）冻在这一行里，
/// 回调**只跟这一行比**，不再重算。于是它不仅挡得住多 SKU，也挡得住折扣 ——
/// 而"用券之后应该收多少"是编不进订单号里的。
model CheckoutOrder {
  id Int @id @default(autoincrement())

  /// 我们生成的商户订单号（微信回调用它回来）。全局唯一 = 幂等的锚点之一。
  outTradeNo String @unique @map("out_trade_no")

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 支付通道名（`wechat` / `paddle` / …）。
  provider String

  priceId  String @map("price_id")
  currency String
  /// 销售区域（`CN` / `INTL`）。与币种**分开**：币种说"收什么钱"，
  /// 区域说"这笔交易在哪个法域"，它们现在几乎一一对应但不是同一件事。
  region   String

  /// 🔴 报价三元组，**不可变**。只存实付的话，开票、对账、算净收入、
  /// 回答"双十一让了多少利"这四件事都做不到。
  originalAmountMinor Int @map("original_amount_minor")
  discountMinor       Int @map("discount_minor")
  finalAmountMinor    Int @map("final_amount_minor")

  couponId String? @map("coupon_id")
  coupon   Coupon? @relation(fields: [couponId], references: [id], onDelete: Restrict)

  /// `pending` | `paid` | `failed` | `expired` | `refunded`（见 `ORDER_STATUSES`）。
  status String

  /// 报价时间与失效时间（epoch 毫秒）。到点未付 → 释放券的预留。
  quotedAt  BigInt @map("quoted_at")
  expiresAt BigInt @map("expires_at")

  paidAt    BigInt? @map("paid_at")
  settledAt BigInt? @map("settled_at")

  /// 把订单推进到终态的那条支付事件（`payment_events.(provider, provider_event_id)`）。
  /// 用于"这笔订单是被哪个事件确认的"的排查。**不是**幂等键 —— 幂等在 `payment_events`。
  providerEventId String? @map("provider_event_id")

  /// 报价时被拒的候选券（JSON 数组），用于回答"我那个码为什么不能用"。
  /// 冗余存一份是刻意的：券的定义以后会变（过期、停用、用满），
  /// 而"用户当时为什么被拒"必须按**当时**的定义回答。
  rejectedCouponsJson String? @map("rejected_coupons_json")

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  /// 这一单的券核销行（如果有）。`orderId` 上的唯一约束在 `CouponRedemption` 那边，
  /// 它同时强制了"一单只能用一张券"这条产品策略。
  redemption CouponRedemption?

  /// 这一单的退款行（0 或 1 条有效退款；见 `Refund` 的注释里"为什么允许多行"）。
  refunds Refund[]

  @@index([userId, status])
  @@index([status, expiresAt])
  @@map("checkout_orders")
}

/// 一次**券核销**：状态机 + 金额快照。
///
/// ## 状态机
///
/// ```
/// reserved ──(支付成功)──▶ applied
///    │                        │
///    │(订单过期/失败)          │(退款)
///    ▼                        ▼
/// expired                  reversed
/// ```
///
/// 🔴 三条不可动摇的规则：
/// 1. **`reversed` 不归还名额，`expired` 归还。** 退款不"回血"：总量限额是
///    "预算已投放"的语义，归还意味着同一份预算可以被买→退→再买反复薅。
///    （行业默认也是不自动归还：微信商家券要商户**主动**调退券接口才回卡包。）
///    而 `expired` **必须**释放名额 —— 否则一张限 100 张的券会被 100 个
///    "点了支付但没付"的单永久占满，sweep 就毫无意义了。
///    唯一事实源是 `pricing-store.ts` 的 `COUNTED_REDEMPTION_STATES`。
/// 2. **`reserved` 也占名额。** 否则刷预留就能把限量券占满。
/// 3. **`order_id` 唯一** 是"同一单不会被核销两次"的数据库层保证 ——
///    幂等不靠应用层记得判。（`order_id` 唯一已经蕴含 `(coupon_id, order_id)`
///    唯一，所以没有再声明后者。）
model CouponRedemption {
  id Int @id @default(autoincrement())

  couponId String @map("coupon_id")
  coupon   Coupon @relation(fields: [couponId], references: [id], onDelete: Restrict)

  userId Int  @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 🔴 **一单一券**：这个唯一约束就是"同一订单不会被核销两次"的保证，
  /// 也是"一单只能用一张券"这条产品策略的落点。
  orderId Int          @unique @map("order_id")
  order   CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// `reserved` | `applied` | `expired` | `reversed`（见 `REDEMPTION_STATES`）。
  state String

  /// 核销时冻结的金额。与订单上的三元组同值，冗余存一份是为了让这张表的
  /// 一行**自己就能说清**减了多少 —— 对账时不必 join。
  originalAmountMinor Int    @map("original_amount_minor")
  discountMinor       Int    @map("discount_minor")
  finalAmountMinor    Int    @map("final_amount_minor")
  currency            String

  /// 预留到期（epoch 毫秒）。到点仍未 `applied` → sweep 置为 `expired`。
  reservedUntil BigInt @map("reserved_until")

  createdAt BigInt  @default(0) @map("created_at")
  appliedAt BigInt? @map("applied_at")
  /// 离开 `reserved` 的时刻（无论去了 applied / expired / reversed）。
  settledAt BigInt? @map("settled_at")

  /// 统计"这张券用了多少"、"这个用户用了多少"都走这两个索引。
  @@index([couponId, state])
  @@index([couponId, userId, state])
  /// sweep 的扫描面：`state = 'reserved' AND reserved_until < now`。
  @@index([state, reservedUntil])
  @@map("coupon_redemptions")
}

// ---------------------------------------------------------------------------
// 退款（临时方案：7×24 小时内全额，超期默认不退，例外只走运营后台）
// ---------------------------------------------------------------------------

/// 一次**退款申请**及其终态。ADR-0053。
///
/// ## 为什么这张表是"钱侧唯一的一行"，而 `checkout_orders.status='refunded'` 不算
///
/// 订单状态只说"结果"，说不出**是谁在什么时候按什么口径退的**。退款是可争议
/// 的（用户会说"我七天内申请过"），所以那一次判断必须原样留在库里：
/// `reason` 存被拒时的口径码、`operator_note` 存批例外时的理由、
/// `amount_minor` 存**冻结下来的实付**（不是原价、不是报价）。
///
/// ## 一个订单为什么可以有多行
///
/// 退款**失败**（通道拒、余额不足）后运营者要能重试，而微信要求重试换一个
/// `out_refund_no`。所以这里 `(order_id)` 上只是索引，不是唯一约束。
/// 🔴 但"同一笔钱退两次"仍然不可能 —— 它挡在两处，缺一不可：
/// - 库里：`checkout_orders.status` 一旦推进到 `refunded` 就再也进不来
///   （`decideRefundEligibility` 对 `refunded` 直接判 `ALREADY_REFUNDED`，
///   而 `reverseOrderOnRefund` 的 `WHERE status = 'paid'` 是第二道）；
/// - 通道：`(provider, out_refund_no)` 唯一，重投的同一通知被幂等键挡住。
///
/// ## 每一列都是可选或带默认值以外的**必填**？
///
/// 这是**新表**，没有存量行，所以这里允许 `NOT NULL` 且无默认的列
/// （`amount_minor`、`currency`、`period_days`、`out_refund_no`）。
/// AGENTS §3.3 那条"新字段必须可选"管的是**已落盘的数据**，不是新对象。
/// 反过来，把金额写成可空会让"退一个算不清的数"变成可能 —— 那正是 §3.3 要防的形状。
model Refund {
  id Int @id @default(autoincrement())

  orderId Int          @map("order_id")
  order   CheckoutOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// 退款属于哪个账号。**冗余自订单**，为的是"按用户查退款"不用 join 订单表，
  /// 也让权益回收那一步能直接用它定位订阅行（`subscription-boundary.md` §6.2 一行一用户）。
  userId Int @map("user_id")

  /// 支付通道名。与 `checkout_orders.provider` 同值 —— 退款必须回到**同一个**通道，
  /// 不存在"从另一条通道退"这种操作。
  provider String

  /// 🔴 我方退款单号，发给通道的幂等键。**由本仓库生成、原样使用**，
  /// 与 `checkout_orders.out_trade_no` 的关系同源于下单那一条纪律。
  /// 微信的"退款查询 / 退款通知"也都以它回锚，所以它同时是回调侧唯一的认单依据。
  outRefundNo String @unique @map("out_refund_no")

  /// 通道侧的退款 id（微信 `refund_id`）。`null` = 还没拿到通道受理，或压根没通道。
  providerRefundId String? @map("provider_refund_id")

  /// 退多少钱（最小单位整数）。**冻结在申请成功的那一刻**，之后改价目表/券都影响不到它。
  amountMinor Int @map("amount_minor")

  /// 币种。必填、无默认：金额是"最小单位的整数"，不带币种就不可比
  /// （同 `CreateCheckoutInput.currency`，两处是同一个理由）。
  currency String

  /// 🔴 这一单当初授予了**多少天**。权益回收扣的就是这一段。
  ///
  /// 为什么把天数存下来而不是回收时再算：退款发生在授予之后，中间可能有
  /// 第二次购买、可能有别的通道的事件先到。把"这一段有多长"冻在退款行上，
  /// 回收才是一个**可重放**的减法，而不是对当前状态的猜测。
  /// 写入侧的唯一来源是 `SUBSCRIPTION_PERIOD_DAYS`（见 `refund-policy.ts`）。
  periodDays Int @map("period_days")

  /// `requested` | `approved` | `rejected` | `processing` | `success` | `abnormal` | `closed` | `failed`
  /// （词表在 `refund-store.ts` 的 `REFUND_STATUSES`，与下单侧同一套做法：库不设 CHECK，
  /// 由写入函数在**词表外**直接抛。）
  status String @default("requested")

  /// 被拒 / 失败时的**口径码**（`WINDOW_PASSED`、`REFUND_CHANNEL_UNAVAILABLE`…）。
  /// 存码不存句子：句子会变（中文/英文/文案改写），码才是可对账的事实。
  reason String?

  /// 运营者批例外时写的理由。`operatorApproved` 是**唯一**能跳过时间窗的开关，
  /// 所以它必须留下"谁批的、为什么批"（`requested_by` / `decided_by` 是那两个"谁"）。
  operatorNote String? @map("operator_note")

  requestedBy Int? @map("requested_by")
  decidedBy   Int? @map("decided_by")

  requestedAt BigInt  @default(0) @map("requested_at")
  decidedAt   BigInt? @map("decided_at")
  /// 通道确认退款成功的时刻。**只有这一列非空才允许动权益。**
  refundedAt  BigInt? @map("refunded_at")

  createdAt BigInt @default(0) @map("created_at")
  updatedAt BigInt @default(0) @map("updated_at")

  /// 后台列表：按账号翻退款。
  @@index([userId, status])
  /// 权益回收与"这一单退过没有"的查找回路。
  @@index([orderId, status])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// Windows PWA 小组件的 Web Push 订阅（见 docs/plans/multi-platform-widgets.md 的 U12）
// ---------------------------------------------------------------------------

/// 一台设备的推送订阅。
///
/// 🔴 **`endpoint` 本身就是一个凭据。** 它是推送服务签发的能力 URL ——
/// 拿到它的人就能给这台设备发任意载荷（载荷是密文，所以读不到内容，
/// 但能反复打扰用户）。所以：**不要把它记进日志、不要回显给前端**。
/// 它在这里的存在方式是"主键式的查找键"，不是"可展示的数据"。
///
/// 为什么 `endpoint` 全局唯一（而不是 `(userId, endpoint)`）：同一个浏览器
/// 订阅只可能属于一个身份 —— 重新订阅时拿到的会是一个**新的** endpoint。
/// 唯一约束让"重新订阅"变成一个自然的 upsert，而不是往库里堆重复行。
/// ⚠️ 反过来说：谁掌握了这个 URL 谁就能把它注册到自己名下。这是 Web Push
/// 协议本身的性质（能力即身份），不是这里的取舍。
model WidgetPushSubscription {
  id         Int    @id @default(autoincrement())
  userId     Int    @map("user_id")
  endpoint   String @unique
  /// 用户代理的 P-256 公钥，base64url 编码的 65 字节未压缩点。
  p256dh     String
  /// 用户代理的认证密钥，base64url 编码的 16 字节。
  auth       String

  /// 🔴 **连续失败次数**，到阈值由调用方删除这一行。
  ///
  /// 为什么要计数而不是一失败就删：`429` / `5xx` 是推送服务自己的问题，
  /// 删掉订阅等于惩罚用户。而**永远的**失败（推送服务持续返回 410 之外的错
  /// 但设备其实已经卸载）需要一个收尾机制，否则这张表会无限增长。
  /// 只统计**确定指向这一行有问题**的结果（见 repo 的 `recordPushFailure`）。
  failureCount Int @default(0) @map("failure_count")

  createdAt  BigInt  @map("created_at")
  /// 最后一次成功发送的时间。用来排查"这个订阅还有没有在用"。可空。
  lastUsedAt BigInt? @map("last_used_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// ⚠️ 索引是给"取某个用户的所有订阅"用的 —— 那是推送时唯一的热路径。
  /// 普通 `CREATE INDEX` 就够：这张表与用户数同阶，永远不大
  /// （AGENTS.md §4 优先级 1：表够小就别用 CONCURRENTLY）。
  @@index([userId])
  @@map("widget_push_subscriptions")
}

/// 邀请码：**一个账号一张**，惰性生成（第一次打开「活动」页时才建）。
///
/// ## 为什么单独一张表，而不是给 `users` 加一列
///
/// 加一列也能跑，但那会把一件**运营事实**焊进账号身份表：邀请码可以停用
/// （`disabled`）、将来可能轮换，而 `users` 那一行的每一列都在回答
/// "这个账号是谁"。分开之后，`users` 不必为一个福利功能变宽，
/// 停用一张码也不会碰到身份数据。
///
/// ## 为什么惰性生成
///
/// 注册时生成的话，绝大多数账号的码**永远不会被用到**（他们会来注册但不会去邀请），
/// 而那些码每一张都要占一个全局唯一值。惰性生成让这张表只装"真的想邀请人"的账号。
///
/// ⚠️ 这**不是**一个安全边界：码是公开可分享的（它就是要被贴出去的东西），
/// 拿到码不等于拿到任何权限 —— 它只能被兑换成"邀请人得到 5 天会员"。
model InviteCode {
  id Int @id @default(autoincrement())

  /// 用户可分享的码，`normalizeInviteCode()` 归一化之后的大写形式（唯一事实源）。
  /// 🔴 长度受 `INVITE_CODE_LENGTH` 约束，且**不含易混字符**（0/O、1/I/L）——
  /// 这个码是要被人**手抄/口述**的。
  code String @unique

  /// 停用开关。🔴 停用是运营动作，**删除不是** —— 删了会让历史邀请查不到出处。
  disabled Boolean @default(false)

  createdAt BigInt @default(0) @map("created_at")

  /// 一个账号一张码，所以这里是 `@unique`：它同时是"惰性生成的并发闸门"
  /// （两个并发的 `ensureInviteCode` 会有一个撞 P2002，重读即可）。
  userId Int  @unique @map("user_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("invite_codes")
}

/// 一条邀请关系：谁邀请了谁，以及它有没有兑现。
///
/// ## 生命周期
///
/// ```
/// 被邀请人注册时带 ?invite=CODE
///   → 建一行（activatedAt = null，还没兑现）
/// 被邀请人完成邮箱验证
///   → 结算：activatedAt = now / rewardDays / rewardedAt 一起写上
/// ```
///
/// 🔴 **"先登记、后兑现"是刻意的**：注册时还不知道这个邮箱是不是真的，
/// 那一刻发奖等于让任何人用任意邮箱刷会员。而 `isVerified` 从 0 变 1
/// 是一个**只有邮箱主人本人**才能触发的动作（要拿到那封信里的链接）。
///
/// ## `inviteeUserId` 上的唯一约束是承重的
///
/// 它不是"整洁"，而是**防重复发奖的数据库级保证**：一个被邀请人只能被算一次。
/// 只靠应用层的"查一下有没有"会在并发下双发（两个验证请求同时到达）。
/// 有了它，第二次写入是 P2002，而结算路径本来就跑在
/// `isVerified: 0 → 1` 的原子 claim 里，两边合起来才是真的恰好一次。
model Referral {
  id Int @id @default(autoincrement())

  /// 🔴 唯一：一个被邀请人只能被算一次。见上方说明。
  inviteeUserId Int @unique @map("invitee_user_id")
  inviterUserId Int @map("inviter_user_id")

  /// 注册那一刻用的码（**快照**）。不靠 join 回 `invite_codes` 反查：
  /// 码可以被停用，而"这一条邀请是哪张码带来的"是历史事实，不能被改写。
  code String

  createdAt BigInt @default(0) @map("created_at")

  /// 被邀请人完成邮箱验证的时刻。`null` = 还没激活。
  activatedAt BigInt? @map("activated_at")

  /// 实际发出去的奖励天数。**与 `activatedAt` 同进同退** ——
  /// 只有 `activatedAt` 而不记天数，就没法回答"这条邀请到底发了多少天"，
  /// 而那是运营对账时唯一要问的问题。
  rewardDays Int? @map("reward_days")
  rewardedAt BigInt? @map("rewarded_at")

  invitee User @relation("ReferralInvitee", fields: [inviteeUserId], references: [id], onDelete: Cascade)
  inviter User @relation("ReferralInviter", fields: [inviterUserId], references: [id], onDelete: Cascade)

  /// 给"我邀请了谁"这个列表用（按时间倒序）。
  @@index([inviterUserId, createdAt])
  @@map("referrals")
}

/// 同意历史（**只追加**的账）：一个人先后同意过哪几版对外文本。
///
/// ## 为什么这张表现在才建
///
/// `users.terms_document_version` 是一列**指针**，它只能回答"最后一次同意的是哪一版"。
/// 而对外文本承诺的是"重新确认"（`terms.ts` s10），一次重新确认会产生**第二条**事实
/// —— "先同意过 1.0、改版后又同意过 1.1"。一列存不下两件事，所以历史在表里、指针留在列上。
/// 那条迁移文件的注释（`20261006000000_add_terms_document_version/migration.sql:21-23`）
/// 当时写的就是"独立 `UserConsent` 表留给『二次同意需要历史』真正落地的那天" —— 本模型是那天。
///
/// ## 🔴 `kind` 今天只有一个值：`legal_set`
///
/// `docs/research/legal-consumer-contract-terms.md` 层 2 词表里那五项
/// （`terms` / `privacy` / `auto_renew` / `e2ee_risk` / `age_declaration`）假设的是
/// **逐项独立勾选**的界面。今天的界面不是那样：注册时是一个勾覆盖整套文本
/// （`web.auth.terms.label` 逐字是"我同意该服务端提供的服务条款与隐私政策"），
/// 钉住的值是 `legalSetVersion()` 那种**整套**指纹。把一次勾选拆成 `terms` 与 `privacy`
/// 两行，等于**发明**两个用户并没有分别作出的决定 —— 与"不得替用户预勾或发明同意"
/// （`docs/plans/user-journey-and-auth.md`）是同一条纪律。
/// ⇒ 加一个新的 `kind` 的前提是**界面上先有那个独立的勾**，不是反过来。
/// （D-06 的年龄声明、§7.1 的 `ai_disclosure` 都在等各自的勾选项。）
///
/// ## 为什么**不**存 `documentHash`，也不存 `surface`
///
/// 对外文本承诺记录的是"**同意时刻 + 那一套文件的版本号**"（`privacy.ts` 第 12 条）。
/// 哈希与"来自哪个端"都不在那句话里。未经宣告就写进数据库，是先采集后告知 ——
/// 那条立场在 G-28 上专门裁决过：**要记就先改文本，顺序不能反**。
///
/// ## 两个时间戳，但**判据不比时间**
///
/// `acceptedAt` 是客户端声明的点击时刻，`serverReceivedAt` 是服务端收到的时刻。
/// 两列都留是因为它们是对方的证据（客户端时钟不可信，§7 第 19 条：墙上时钟不能裁决因果）。
/// 🔴 而"要不要拦"这件事**只比版本字符串**，绝不比这两个数 —— 比时间会把一个时钟慢了
/// 几秒的新账号读成"同意过旧版的人"，那是一条会自己制造假阳性的判据。
///
/// ## 谁是裁决者
///
/// `kind='legal_set'` 下**最新的一条**记录是裁决依据；一行历史都没有时
/// （这张表之前注册的人）退回 `users.terms_document_version` 那列。
/// ⇒ 写第一笔历史时**必须**与指针在同一个事务里更新，否则会出现
/// "表里有 1.1、指针还写着 1.0" —— 那种不一致的方向是**多拦一次**（fail-closed），
/// 不是漏拦。
model UserConsent {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  /// 同意事项词表（见上面那段）。今天只有 `legal_set`。
  kind String

  /// 那一次同意钉住的**整套**文本版本指纹，与 `legalSetVersion()` 同形（`terms@1.1;…`）。
  documentVersion String @map("document_version")

  /// 客户端声明的点击时刻（epoch ms）。
  acceptedAt BigInt @map("accepted_at")

  /// 服务端收到这条确认的时刻（epoch ms）。`0` = 由迁移/内部写入补的、没有服务端收据。
  serverReceivedAt BigInt @default(0) @map("server_received_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 同一个人对同一版只有一条事实。重复点确认不会长出第二行，
  /// 因此"已确认过当前版本"这件事是幂等的（判据据此就不会反复拦同一个人）。
  @@unique([userId, kind, documentVersion])
  @@index([userId, acceptedAt])
  @@map("user_consents")
}

/// 账号头像（R10，2026-10-02 产品负责人裁决）。**一行一个人**，主键就是 `user_id`。
///
/// ## 🔴 存的是**密文**，而且这一条不是"更安全一点"，是自家对外文本的依据问题
///
/// `packages/legal/src/documents/personal-info-list.ts` 的**表 E「敏感个人信息」**
/// 逐项对照《个人信息保护法》第二十八条，"生物识别"那一行写的是 **❌ 不收集**，
/// 而它给的理由是**结构性**的：「没有任何生物特征模板**离开你的设备**」。
/// 一张明文人脸照片一旦进库，那句话说的是**这个字段/这条通道不存在**，
/// 于是那一行的依据当场失效 —— 不是"变弱"，是**变成假的**。
///（同族裁决见 ADR-0025；调研与逐行对照在
/// `docs/research/countdown-anniversary-data-and-images.md` §4。）
///
/// 表 E 末尾还有一句反过来读才是要害的话：
/// 「这个结论建立在**我们不判断内容**这个前提上，不是建立在**我们看不到内容**上」。
/// 一旦某条通道让我们**看得到**（明文图片），"我们不判断内容"就不再是理由了。
///
/// ⚠️ 也**不能**用"自托管的人自己承担代价"把它做成明文：隐私政策是我们写的，
/// 自托管部署者读的是**同一份**，"不收集生物识别"不能因为部署形态不同就变成假的。
/// 承担代价说的是**存储与带宽**，不是**改变对外承诺的事实**。
///
/// ## 为什么这一条不新增任何前提
///
/// 密文用的是**同步通道那把口令**（`sync-core` 的 `encrypt`）。而
/// `sync-client/src/client.ts:703-709` 已经写明：**没有口令根本同步不了**
///（`reason: 'no-encryption-password'`）。⇒ 头像要跨设备，前提本来就是"能同步"，
/// 而"能同步"蕴含"有口令"。**加密不引入任何一个明文方案没有的条件。**
///
/// ## 密文是 base64 字符串 ⇒ 不需要上传通道
///
/// 载荷走 JSON body，与 op 上传**完全同形**，所以服务端不需要 multipart、
/// 不需要自定义 content type parser、不引入任何新依赖（AGENTS §3.1/§3.2 两道门）。
/// 也正因为服务端解不开，它**不知道**这张图是什么格式 ——
/// 所以这里**没有 `content_type` 列**：格式和字节一起进密文，由客户端读回来。
///
/// ## 🔴 `hash` 泄露什么，说清楚
///
/// 它是**密文**的 SHA-256，用作缓存失效键（换图即换 URL，抄 Discord 那个形状）。
/// 同一张图重复上传会得到相同 hash ⇒ 严格说它泄露"两次内容相等"。
/// 今天这条信息只对**本人**可见（无协作、无公开端点），而本人已经知道自己的图，
/// 所以不构成泄露面。⚠️ **将来若开放"别人能看到头像"，这一列要重新评估** ——
/// 那是一次独立决定（同 §8.6 那条边界），不许顺手加。
model UserAvatar {
  userId Int @id @map("user_id")

  /// 密文字节（`encrypt()` 产出的 base64 解码后的 BYTEA —— 存解码形态省 33% 体积，
  /// 线上传输仍是 base64 字符串）。里面是 `{contentType, dataBase64}` 的 JSON，
  /// 所以**图片格式本身也在密文里**。
  cipher Bytes

  /// `cipher` 的 SHA-256（hex）。用途见上面那段。
  hash String

  /// 上传时刻（epoch ms）。
  updatedAt BigInt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_avatars")
}

/// 账号级通知（应用内通知中心的一条）。
///
/// ## 🔴 这里只放**账号级**事实，不放任何用户内容
///
/// E2EE 是硬约束（服务端看不到任务明文），所以这张表**不可能**装
/// "你的任务 X 到期了" 这类通知 —— 那需要解密用户数据。它装的是服务端
/// 本来就知道的事：谁用你的邀请码激活了、给你发了几天会员。
/// 载荷里因此只有**显示名 + 天数**这类账号级字段。
///
/// ## 为什么存 `kind` + `payload` 而不是渲染好的文案
///
/// 文案是**客户端**的事（界面文案唯一事实源是 `packages/i18n`，
/// 而且用户随时能切语言）。服务端存的是"发生了什么"，客户端负责
/// "这件事该怎么用中文说"。存成品文案的话，改一次措辞就要写一条数据迁移。
model AccountNotification {
  id Int @id @default(autoincrement())

  userId Int @map("user_id")

  /// 事件类型词表，客户端据此选图标与措辞模板。
  /// ⚠️ 未知 `kind` 必须被客户端**优雅跳过**（而不是渲染出一条空白通知）——
  /// 老客户端遇到新事件是正常的。
  kind String

  /// 措辞参数（如被邀请人显示名、奖励天数）。🔴 账号级事实，不含用户内容。
  payload Json @default("{}")

  createdAt BigInt @default(0) @map("created_at")

  /// 已读时刻。`null` = 未读。用时间戳而不是布尔，是为了将来能回答"什么时候读的"，
  /// 而布尔一旦写下去就再也补不回来。
  readAt BigInt? @map("read_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  /// 唯一的热路径：取某人的通知、按时间倒序。
  @@index([userId, createdAt])
  @@map("account_notifications")
}

/// 调休/补班公告的**年度录入**（一行 = 一个年度 = 一次运营录入）。W4b。
///
/// ## 这是 heyta 第一条服务端→客户端的**内容**通道的数据源
///
/// 定性见 [ADR-0052](../../docs/adr/0052-public-facts-are-deployer-supplied.md) §2：
/// 它装的是**公共事实**（国务院哪天让上班、哪天让放假 + 公告原文出处），
/// 不是用户数据 ⇒ 不进 op-log、不加密、不参与向量时钟与 LWW。
/// AGENTS §1 那句「云端不是事实源」约束的是用户数据，不约束这一张表。
///
/// ## 为什么是两张表而不是一张表 + 一个 `Json` 的 `days`
///
/// 判据③要求"日期非法 / `isOffDay` 不是布尔"**在库层就拦得住**，而
/// `Json` 列对这两件事一个都不拦：`{"day":"2026-02-30","isOffDay":1}`
/// 是一段完全合法的 JSON，Postgres 存得下去、服务端读得出来，
/// 于是症状推迟到客户端 —— 那一天永远不上界面（`2 月 30 日` 谁都查不到），
/// 而 `isOffDay: 1` 会被当成"休"，把一个补班日标成放假日。
/// **界面在说谎，而两层都没报错**，这就是把校验下沉到列类型的那个数钱的理由。
///
/// 于是：`holiday_adjustment_days` 用 `DATE` 主键 + `BOOLEAN NOT NULL`；
/// 这张表只存**元信息与出处**（`papers` 是数组，逐日表里没必要重复 40 遍）。
///
/// ## 为什么"全有或全无"必须在写入层而不是读取层
///
/// 一年一次录入。允许"2027 年有 3 天，其中 1 天校验失败但另 2 天先存进去"，
/// 客户端就会拿到一个**半套**的 2027 年：那半天在界面上显示"休"，
/// 另外半天什么都不显示，而这两者都是"部署方下发的权威数据"的表现形式。
/// 判据④因此要求"非法 ⇒ 整年拒绝"，实现见 `packages/domain` 的
/// `installHolidayAdjustmentOverrides()`（先在校验副本上跑完，再一次性提交）。
model HolidayAdjustmentYear {
  /// 年份本身是主键：一年一条，`2027.5` 与重复年份在库里装不下。
  year Int @id

  /// 🔴 公告原文出处（gov.cn 的链接）。**不许为空** —— 没有出处的节假日数据
  /// 不能进库，这条纪律随包那份 `scripts/vendor/holiday-cn/load.mjs:52` 先立过，
  /// 运营录入没有理由比自动抓取更宽松。判据②"链接随数据入库且能回显"要看的就是它。
  papers String[] @default([])

  /// 运营备注（例如「据 2026-11 调整公告，原定 10-11 上班改为不上班」）。
  /// 可选：它只是给人看的线索，不参与任何裁决。
  note String?

  /// 写入时间与操作者（追责与回滚都要它；`updatedBy` 是邮箱字符串而不是外键 ——
  /// 与 `PriceVersion.createdBy` 同一决定：录入可能来自 CLI/运维，强绑 `users`
  /// 会让"脚本代录"无法表达）。
  updatedAt BigInt  @default(0) @map("updated_at")
  updatedBy String? @map("updated_by")

  days HolidayAdjustmentDay[]

  @@map("holiday_adjustment_years")
}

/// 逐日表：某一天是**放假**（`true`）还是**补班**（`false`）。W4b。
///
/// 🔴 一张**没有这列就拦不住判据③**的表 —— 见 `HolidayAdjustmentYear` 那段。
/// `day` 用 `DATE`（不是 `String`）正是为了让 `2026-02-30` 在库里就不是一个值。
model HolidayAdjustmentDay {
  /// 主键 = 那一天：同一天既休又补班、或同一天录两条，物理上装不下。
  ///
  /// ⚠️ Prisma 把 `DATE` 列读成 **UTC 零点的 `Date`**。回成字符串只能用
  /// `toISOString().slice(0, 10)`，**不许**用本地 getter（`packages/domain` 的
  /// `toLocalDate()`）—— 那会让 UTC-5 的部署把 `2027-01-01` 读成 `2026-12-31`。
  /// 这条是 `dayColumnToIso()` 存在的全部理由，钉在
  /// `server/tests/holiday-adjustment-migration.pglite.spec.ts`。
  day      DateTime @id @map("day") @db.Date
  isOffDay Boolean  @map("is_off_day")

  /// 冗余一份年份：取某一年的全部安排是热路径（后台回显、公开 GET 都按年取），
  /// 而 `day::date` 上的主键范围扫描要走索引边界。也是 CHECK「年份与日期必须一致」
  /// 的左操作数 —— 没有这一列，那条约束就得每次逐行 cast。
  year     Int

  yearRef HolidayAdjustmentYear @relation(fields: [year], references: [year], onDelete: Cascade)

  @@index([year])
  @@map("holiday_adjustment_days")
}

/// 托管 AI 的**用量计数器**：一行 = 一个账号在一个计费周期里用掉了几次。
///
/// 依据：[ADR-0054](../../../docs/adr/0054-managed-ai-retention-and-selling-preconditions.md) §2
///（保留裁决）与 [ADR-0023](../../../docs/adr/0023-managed-ai-quota-not-implemented.md) §5 第 3 条。
/// 写入与裁决在 `server/src/ai/metering.ts`，库层证据在
/// `server/tests/ai-metering.pglite.spec.ts`。
///
/// ## 🔴 这张表的**列集合本身**就是对外承诺
///
/// 只有下面四列。**没有 `prompt`、没有 `completion`、没有 `payload`、
/// 也没有一个 `Json` 兜底列** —— 这不是"以后再加"，是**故意装不下**：
/// 一张带 `payload Json` 的表会在某次"顺手存一下便于排障"之后变成事实上的内容仓库，
/// 而那时《AI 服务条款》§5.3 与隐私政策里"服务端不保留内容"那几句全都成了假话，
/// 且**没有任何一层会报错**。判据断言列集合**等于**这四个（多一列就红），
/// 不断言"没有内容列" —— 黑名单永远漏掉下一个想加的名字。
///
/// ## 为什么 `periodAnchor` 是计费周期边界，不是自然月
///
/// 一次付款买 **30 天**（`packages/domain` 的 `SUBSCRIPTION_PERIOD_DAYS`），起点是支付
/// 成功那一刻，**不是每月 1 号**。锚点取 `subscriptions.current_period_end`：
/// 取自然月会让 9 月 20 日付的钱在 10 月 1 日**清零重来**（一次付款拿两轮 300）；
/// 服务端自己拿墙上时钟 +30 天则与库里已有的权威边界**各说各话**。
/// 跨边界自然落到**另一行**，新的一轮从 0 开始 —— 这条由 pglite 那条锚点算术钉住。
///
/// ## 为什么 `requests` 是普通整数，而不是 `Json`
///
/// 裁决要在**一条语句**里读、比、+1（`… WHERE requests < N RETURNING requests`），
/// 那依赖 `INTEGER` 上的算术与比较；`Json` 给不了原子 +1，也给不了
/// `CHECK (requests >= 0)`，于是"负数一行就多一次额度"这类残留只能靠人记得。
/// 一旦开了 `Json`，下一个人塞进来的第一个键就会是 `prompt`。
model AiUsageCounter {
  /// 归属账号。**级联删除**是保留承诺的一半（ADR-0054 §2「计数随账号级联删除」）：
  /// 少了它，删掉的账号会留下一堆指向不存在的 `user_id` 的计数行 —— 任何界面读不到、
  /// 任何清理任务不知道该删谁，"删账号即删"就只在文档里成立。
  userId Int  @map("user_id")

  /// 这一行属于**哪一个计费周期** = 该周期结束时刻（epoch 毫秒），
  /// 出处是 `subscriptions.current_period_end`（唯一权威边界，不做墙上时钟推算）。
  ///
  /// 🔴 它与 `userId` 合起来是唯一键，这有两件事一起做成了：
  /// 1. 「新周期从 0 开始」= 换锚 = 换一行，不需要任何"清零"写入，也没有清零窗口；
  /// 2. 同一账号同一周期的并发 +1 撞在同一行上 ⇒ 被行锁串行化（裁决的原子性靠它）。
  /// 第二件事是 `metering.ts` 那条 `WHERE requests < N` **能守住并发**的前提。
  periodAnchor BigInt @map("period_anchor")

  /// 本周期已用次数。`>= 0` 钉在库里（迁移里的 `ai_usage_counters_requests_non_negative`）：
  /// 应用路径只做 +1，但这张表还有运维脚本与未来的重置迁移**不是应用路径**的写入口。
  requests Int @default(0)

  /// 最后一次 +1 的时刻（epoch 毫秒）。它是**元数据**不是内容，
  /// 用来回答"这一期额度是什么时候用掉的"，不参与任何裁决。
  ///
  /// 🔴 别把 ADR-0054 §4 那份"时间 / 功能名 / 结果状态 / 字节数 / 耗时"读成这张表 ——
  /// 那份清单说的是**每次调用一行的运维审计日志**（`recordManagedAiAttempt`），
  /// 上限是日志容量而不是天数。这张表只有上面这四列，多一列 `ai-metering.pglite` 就红。
  /// 两者的区别记在 ADR-0054 §4.1（2026-10-05 落地更正）。
  updatedAt BigInt @default(0) @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, periodAnchor])
  @@map("ai_usage_counters")
}
