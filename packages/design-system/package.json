{
  "name": "@heyta/design-system",
  "version": "0.0.0",
  "private": true,
  "description": "heyta 设计系统 —— 蓝白色系，所有设计变量的唯一事实源",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tokens.css": "./src/tokens.css",
    "./reset.css": "./src/reset.css",
    "./native": {
      "types": "./dist/native.d.ts",
      "import": "./dist/native.js",
      "require": "./dist/native.cjs"
    }
  },
  "files": [
    "dist",
    "generated",
    "src/tokens.css",
    "src/reset.css"
  ],
  "scripts": {
    "build": "tsup",
    "generate": "tsup --config tsup.generate.config.ts && node dist/generate-cli.js",
    "generate:check": "tsup --config tsup.generate.config.ts && node dist/generate-cli.js --check",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
