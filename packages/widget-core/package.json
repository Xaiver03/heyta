{
  "name": "@heyta/widget-core",
  "version": "0.0.0",
  "sideEffects": false,
  "private": true,
  "description": "系统小组件的共享契约：v:1 快照信封 + 明文载荷、选择器（从物化状态投影）、意图队列语义。零**第三方**运行时依赖（只用仓库内纯 TS 包），且**类型上产生不了 op**。",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fixtures:gen": "UPDATE_FIXTURES=1 vitest run tests/fixtures.spec.ts",
    "gen:adaptive-cards": "node scripts/emit-adaptive-cards.mjs",
    "check:adaptive-cards": "node scripts/emit-adaptive-cards.mjs --check"
  },
  "dependencies": {
    "@heyta/design-system": "workspace:*",
    "@heyta/domain": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
