{
  "name": "@heyta/domain",
  "version": "0.0.0",
  "private": true,
  "description": "heyta 领域层：纯业务逻辑，无框架依赖（四象限 / 习惯连续天数 / 番茄钟状态机 / 重复规则）",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "default": "./dist/index.js" }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit -p tsconfig.spec.json",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@heyta/shared-schema": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^5.0.1"
  }
}
