#!/bin/sh
# macOS 兼容垫片：把 GNU sed 的 `-i` 用法翻译成 BSD sed 的用法。
#
# 为什么需要：
#   上游的 migrate-deploy.sh 是为 Linux（GNU sed）写的，其中有一处：
#       sed -i "s/.../.../g" "$FILE"
#   macOS 自带的是 BSD sed，它要求 `-i` 后面**必须**跟一个备份后缀参数，
#   于是 `-i "s/.../"` 会被它理解成「备份后缀 = s/.../」，报
#   `invalid command code f` 然后失败。
#
#   Docker 镜像里是 Linux，**不需要**这个垫片。它只用于在 macOS 上
#   直接跑那些部署脚本做本地验证。
#
# 用法：把它所在目录放到 PATH 最前面即可。
#   export PATH="$PWD/research/tools/macos-sed-shim:$PATH"
#   sh scripts/migrate-deploy.sh

real_sed="${REAL_SED:-/usr/bin/sed}"

# 只处理 `-i` 出现在参数开头的情况；其余原样透传。
case "${1:-}" in
  -i)
    # GNU: sed -i SCRIPT FILE...   →  BSD: sed -i '' SCRIPT FILE...
    shift
    exec "$real_sed" -i '' "$@"
    ;;
  -i*)
    # 形如 -i.bak 的显式后缀：BSD 同样接受，直接透传。
    exec "$real_sed" "$@"
    ;;
  *)
    exec "$real_sed" "$@"
    ;;
esac
