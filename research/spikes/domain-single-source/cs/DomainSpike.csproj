<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>DomainSpike</AssemblyName>
    <RootNamespace>DomainSpike</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- Jint：纯 C# 的 ECMAScript 引擎（MIT）。选它而不是 ClearScript/V8，
         是因为它没有原生依赖 —— 桌面端本来就在为"少一个原生依赖"付代价。 -->
    <PackageReference Include="Jint" Version="4.16.4" />
  </ItemGroup>

</Project>
